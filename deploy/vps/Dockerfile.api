# API runtime image, built ON the VPS from an app published elsewhere (deploy.sh rsyncs it to ./app): no SDK and
# no compiling on the shared server. Same runtime as src/Server/SkyMessage.Api/Dockerfile.
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS aspnet

# Debian 13: its ffmpeg 7.1 decodes tiled iPhone HEIC photos.
FROM debian:trixie-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata libicu76 libssl3t64 libstdc++6 zlib1g ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1654 app && useradd --uid 1654 --gid app --create-home app
COPY --from=aspnet /usr/share/dotnet /usr/share/dotnet
RUN ln -s /usr/share/dotnet/dotnet /usr/bin/dotnet
WORKDIR /app
COPY app/ .
ENV ASPNETCORE_HTTP_PORTS=8080 \
    DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_gcServer=0
EXPOSE 8080
USER app
ENTRYPOINT ["dotnet", "SkyMessage.Api.dll"]
