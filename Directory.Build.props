<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;NU1507</NoWarn>
    <Company>SkyMessage</Company>
    <Product>SkyMessage</Product>
    <!--
      Version = <prefix>.<build number>. Release builds (CI, .github/workflows/release.yml) pass
      -p:SkyMessageBuildNumber=N, which grows with every release from main: it is also the Android versionCode that
      installed apps compare to update themselves. Local builds use 0. Bump the prefix for notable releases.
    -->
    <SkyMessageVersionPrefix>0.2</SkyMessageVersionPrefix>
    <SkyMessageBuildNumber Condition="'$(SkyMessageBuildNumber)' == ''">0</SkyMessageBuildNumber>
    <SkyMessageVersion Condition="'$(SkyMessageVersion)' == ''">$(SkyMessageVersionPrefix).$(SkyMessageBuildNumber)</SkyMessageVersion>
    <Version>$(SkyMessageVersion)</Version>
  </PropertyGroup>
</Project>
