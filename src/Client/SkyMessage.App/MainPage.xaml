<?xml version="1.0" encoding="utf-8" ?>
<!--
  Hosts the shared Blazor UI. The BlazorWebView is created in code so it can be rebuilt when the WebView
  renderer dies. Edge-to-edge: the page ignores safe areas; native insets are pushed into the page as CSS
  variables (sm-safe-top/right/bottom/left and sm-kb-inset).
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SkyMessage.App.MainPage"
             SafeAreaEdges="None"
             BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0F1117}">

    <Grid x:Name="Root" SafeAreaEdges="None" />

</ContentPage>
