<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.social-networking</string>
    <key>UIDeviceFamily</key>
    <array>
        <integer>2</integer>
    </array>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>XSAppIconAssets</key>
    <string>Assets.xcassets/appicon.appiconset</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>ru</string>
        <string>en</string>
    </array>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.skymessage.messenger</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>skymessage</string>
            </array>
        </dict>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- Development servers on localhost / the LAN are plain http; public servers must use https. -->
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>NSCameraUsageDescription</key>
    <string>SkyMessage uses the camera for video calls, video messages and photos you send.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>SkyMessage uses the microphone for calls and voice messages.</string>
    <key>NSContactsUsageDescription</key>
    <string>SkyMessage finds people from your phone book who already use SkyMessage. Nothing is imported without your confirmation.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>SkyMessage saves photos and videos you choose to your library.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>SkyMessage connects to a server on your local network when you use one.</string>
</dict>
</plist>
