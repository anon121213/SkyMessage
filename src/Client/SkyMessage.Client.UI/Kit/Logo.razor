@* SkyMessage logo (our own artwork, docs/DESIGN.md): a warm sun rising behind a white cloud with three sparkles, on a
   twilight squircle (deep indigo → violet → rose, a peach glow on the horizon). Mark = sun and cloud without the tile,
   the cloud filled with the twilight gradient. Animated = the sun breathes, the cloud floats, the sparkles glint. The
   app icon and splash (SkyMessage.App/Resources) draw the same picture. *@
<svg class="sm-logo @(Animated ? "sm-logo--animated" : null) @Class" style="@($"width:{Rem};height:{Rem}")" viewBox="0 0 456 456" role="img" aria-label="SkyMessage">
    <defs>
        <linearGradient id="@($"{_id}-sky")" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#3D2BD9" />
            <stop offset="0.52" stop-color="#7B3FEA" />
            <stop offset="1" stop-color="#D452A8" />
        </linearGradient>
        <radialGradient id="@($"{_id}-horizon")" cx="0.78" cy="1.02" r="0.72">
            <stop offset="0" stop-color="#FFB37A" stop-opacity="0.9" />
            <stop offset="1" stop-color="#FFB37A" stop-opacity="0" />
        </radialGradient>
        <radialGradient id="@($"{_id}-light")" cx="0.22" cy="0.08" r="0.62">
            <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.28" />
            <stop offset="1" stop-color="#FFFFFF" stop-opacity="0" />
        </radialGradient>
        <radialGradient id="@($"{_id}-sun")" cx="0.42" cy="0.38" r="0.62">
            <stop offset="0" stop-color="#FFF6D2" />
            <stop offset="0.45" stop-color="#FFCB6E" />
            <stop offset="1" stop-color="#FF8A65" />
        </radialGradient>
        <radialGradient id="@($"{_id}-halo")" cx="0.5" cy="0.5" r="0.5">
            <stop offset="0.45" stop-color="#FFD58A" stop-opacity="0.6" />
            <stop offset="1" stop-color="#FFD58A" stop-opacity="0" />
        </radialGradient>
        <linearGradient id="@($"{_id}-cloud")" gradientUnits="userSpaceOnUse" x1="0" y1="150" x2="0" y2="345">
            <stop offset="0" stop-color="#FFFFFF" />
            <stop offset="1" stop-color="#E9E1FF" />
        </linearGradient>
        <linearGradient id="@($"{_id}-cloud-mark")" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#6A4BFF" />
            <stop offset="1" stop-color="#B04FE0" />
        </linearGradient>
    </defs>
    @if (!Mark)
    {
        <path d="M228 0C404 0 456 52 456 228S404 456 228 456 0 404 0 228 52 0 228 0Z" fill="@($"url(#{_id}-sky)")" />
        <path d="M228 0C404 0 456 52 456 228S404 456 228 456 0 404 0 228 52 0 228 0Z" fill="@($"url(#{_id}-horizon)")" />
        <path d="M228 0C404 0 456 52 456 228S404 456 228 456 0 404 0 228 52 0 228 0Z" fill="@($"url(#{_id}-light)")" />
    }
    <g class="sm-logo__sun">
        <circle cx="292" cy="186" r="116" fill="@($"url(#{_id}-halo)")" />
        <circle cx="292" cy="186" r="72" fill="@($"url(#{_id}-sun)")" />
    </g>
    <g class="sm-logo__cloud">
        @if (!Mark)
        {
            <ellipse cx="236" cy="352" rx="128" ry="16" fill="#2A1470" opacity="0.18" />
        }
        <g fill="@(Mark ? $"url(#{_id}-cloud-mark)" : $"url(#{_id}-cloud)")">
            <circle cx="168" cy="268" r="62" />
            <circle cx="238" cy="230" r="80" />
            <circle cx="312" cy="280" r="54" />
            <rect x="106" y="262" width="262" height="78" rx="39" ry="39" />
        </g>
    </g>
    @if (!Mark)
    {
        <g fill="#FFFFFF">
            <path class="sm-logo__spark" transform="translate(98 104) scale(1.25)" opacity="0.95"
                  d="M12 0C12.7 6.6 17.4 11.3 24 12 17.4 12.7 12.7 17.4 12 24 11.3 17.4 6.6 12.7 0 12 6.6 11.3 11.3 6.6 12 0Z" />
            <path class="sm-logo__spark sm-logo__spark--2" transform="translate(372 78) scale(0.8)" opacity="0.85"
                  d="M12 0C12.7 6.6 17.4 11.3 24 12 17.4 12.7 12.7 17.4 12 24 11.3 17.4 6.6 12.7 0 12 6.6 11.3 11.3 6.6 12 0Z" />
            <path class="sm-logo__spark sm-logo__spark--3" transform="translate(380 360) scale(0.65)" opacity="0.8"
                  d="M12 0C12.7 6.6 17.4 11.3 24 12 17.4 12.7 12.7 17.4 12 24 11.3 17.4 6.6 12.7 0 12 6.6 11.3 11.3 6.6 12 0Z" />
        </g>
    }
</svg>

@code {
    private readonly string _id = "sm-logo-" + Guid.NewGuid().ToString("N")[..8];

    /// <summary>Size in px at 100% font scale.</summary>
    [Parameter] public double Size { get; set; } = 64;
    /// <summary>Sun and cloud only (gradient cloud), without the tile.</summary>
    [Parameter] public bool Mark { get; set; }
    /// <summary>Ambient motion: breathing sun, floating cloud, glinting sparkles.</summary>
    [Parameter] public bool Animated { get; set; }
    [Parameter] public string? Class { get; set; }

    private string Rem => (Size / 16).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) + "rem";
}
