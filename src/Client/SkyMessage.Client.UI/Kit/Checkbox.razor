@inject HapticFeedback Haptics

<label class="sm-check @(Round ? "sm-check--round" : null) @(Disabled ? "sm-check--disabled" : null) @Class" @onclick:stopPropagation="StopPropagation">
    @* Bound (see Switch): a toggle the parent refuses, e.g. a person who cannot be picked, is put back. *@
    <input type="checkbox" disabled="@Disabled" aria-label="@(Label ?? AriaLabel)" @bind:get="Checked" @bind:set="OnChangeAsync" />
    <span class="sm-check__box"><Icon Name="@IconNames.Check" /></span>
    @if (Label is not null)
    {
        <span class="sm-grow">@Label</span>
    }
    @ChildContent
</label>

@code {
    [Parameter] public bool Checked { get; set; }
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Round selection mark (people pickers).</summary>
    [Parameter] public bool Round { get; set; }
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Keep clicks from reaching a clickable parent row (which toggles by itself).</summary>
    [Parameter] public bool StopPropagation { get; set; } = true;
    [Parameter] public string? Class { get; set; }

    private Task OnChangeAsync(bool value)
    {
        Haptics.Selection();
        return CheckedChanged.InvokeAsync(value);
    }
}
