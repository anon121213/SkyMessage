@* A list row with a switch; tapping anywhere on the row toggles it. *@
@inject HapticFeedback Haptics

<ListItem Title="@Title" Subtitle="@Subtitle" Icon="@Icon" IconColor="@IconColor" Disabled="Disabled" Multiline="Multiline" Class="@Class" OnClick="ToggleAsync">
    <Trailing>
        <Switch Checked="Checked" CheckedChanged="SetAsync" AriaLabel="@Title" Disabled="Disabled" />
    </Trailing>
</ListItem>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? IconColor { get; set; }
    [Parameter] public bool Checked { get; set; }
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Multiline { get; set; } = true;
    [Parameter] public string? Class { get; set; }

    private Task ToggleAsync()
    {
        Haptics.Selection();
        return CheckedChanged.InvokeAsync(!Checked);
    }

    private Task SetAsync(bool value) => CheckedChanged.InvokeAsync(value);
}
