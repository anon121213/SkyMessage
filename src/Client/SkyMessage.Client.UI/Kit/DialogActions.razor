@* Button row at the bottom of dialog content (right-aligned; stacked full width on narrow screens when Stack). *@
<div class="sm-dialog-actions @(Stack ? "sm-dialog-actions--stack" : null) @Class">@ChildContent</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Stack { get; set; }
    [Parameter] public string? Class { get; set; }
}
