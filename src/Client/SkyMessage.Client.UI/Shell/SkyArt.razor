@* Our own illustrations for empty, error and onboarding states: flat, quiet shapes from the sky — a small cloud, the
   sun or the moon, a horizon line — with the app's own pieces (message capsules, squircle faces). No glows, no
   sparkles, no gloss. A little life (a capsule floats, typing dots hop, rain falls), still with reduced motion and in
   lite mode. Decorative: hidden from assistive technology. *@
<svg class="sky-art sky-art--@Kind.ToString().ToLowerInvariant() @Class" style="@($"width:{Rem(Size)};height:{Rem(Size * 0.75)}")" viewBox="0 0 240 180"
     aria-hidden="true" focusable="false">
    @switch (Kind)
    {
        case SkyArtKind.Chats:
            <line x1="28" y1="160" x2="212" y2="160" class="sky-art__horizon" />
            <circle cx="176" cy="44" r="19" class="sky-art__sun" />
            <g class="sky-art__drift sky-art__cloud sky-art__cloud--far">
                <circle cx="56" cy="56" r="10" />
                <circle cx="70" cy="49" r="14" />
                <circle cx="85" cy="57" r="9" />
                <rect x="45" y="54" width="50" height="12" rx="6" />
            </g>
            @Cloud(46, 124, 1)
            <g class="sky-art__float sky-art__float--a">
                <rect x="24" y="82" width="98" height="36" rx="18" class="sky-art__card" />
                <rect x="40" y="94" width="50" height="5" rx="2.5" class="sky-art__line" />
                <rect x="40" y="104" width="32" height="5" rx="2.5" class="sky-art__line sky-art__line--soft" />
            </g>
            <g class="sky-art__float sky-art__float--b">
                <rect x="112" y="58" width="104" height="38" rx="19" class="sky-art__accent" />
                <circle cx="148" cy="77" r="4" class="sky-art__dot" />
                <circle cx="164" cy="77" r="4" class="sky-art__dot sky-art__dot--2" />
                <circle cx="180" cy="77" r="4" class="sky-art__dot sky-art__dot--3" />
            </g>
            break;

        case SkyArtKind.Contacts:
            <line x1="34" y1="160" x2="206" y2="160" class="sky-art__horizon" />
            @Cloud(44, 136, 0.92)
            <g class="sky-art__float sky-art__float--a">
                @Face(54, 58, "sky-art__accent")
            </g>
            <g class="sky-art__float sky-art__float--b">
                @Face(124, 70, "sky-art__warm")
            </g>
            <path d="@Heart" transform="translate(107 30) scale(1.1)" class="sky-art__heart" />
            break;

        case SkyArtKind.Crash:
            <circle cx="166" cy="54" r="19" class="sky-art__sun" />
            <g class="sky-art__float sky-art__float--a">
                <g class="sky-art__cloud">
                    <circle cx="78" cy="96" r="26" />
                    <circle cx="118" cy="78" r="36" />
                    <circle cx="160" cy="98" r="24" />
                    <rect x="52" y="92" width="134" height="32" rx="16" />
                </g>
                <g transform="rotate(-16 120 100)">
                    <rect x="96" y="92" width="48" height="17" rx="8.5" class="sky-art__warm" />
                    <rect x="113" y="92" width="14" height="17" class="sky-art__pad" />
                    <circle cx="104" cy="98" r="1.3" class="sky-art__pore" />
                    <circle cx="104" cy="103" r="1.3" class="sky-art__pore" />
                    <circle cx="136" cy="98" r="1.3" class="sky-art__pore" />
                    <circle cx="136" cy="103" r="1.3" class="sky-art__pore" />
                </g>
            </g>
            @* Positioned by the group: the drop's own transform is its falling motion. *@
            <g transform="translate(88 132)"><path d="@Drop" class="sky-art__drop" /></g>
            <g transform="translate(120 138)"><path d="@Drop" class="sky-art__drop sky-art__drop--2" /></g>
            <g transform="translate(152 132)"><path d="@Drop" class="sky-art__drop sky-art__drop--3" /></g>
            break;

        case SkyArtKind.NotFound:
            <mask id="@Id("moon")">
                <rect width="240" height="180" fill="#FFFFFF" />
                <circle cx="181" cy="40" r="20" fill="#000000" />
            </mask>
            <circle cx="168" cy="52" r="23" class="sky-art__sun" mask="@($"url(#{Id("moon")})")" />
            <circle cx="64" cy="36" r="1.8" class="sky-art__star" />
            <circle cx="112" cy="22" r="1.4" class="sky-art__star" />
            <circle cx="208" cy="92" r="1.6" class="sky-art__star" />
            <circle cx="36" cy="88" r="1.3" class="sky-art__star" />
            <line x1="28" y1="160" x2="212" y2="160" class="sky-art__horizon" />
            @* The way that got lost: a dotted path wandering off the cloud. *@
            <path d="M150 128c18-6 26-22 18-34s-30-8-30 6 22 16 34 2" class="sky-art__path" />
            @Cloud(40, 130, 0.86)
            break;

        default:
            <line x1="40" y1="166" x2="200" y2="166" class="sky-art__horizon" />
            @Cloud(44, 142, 0.88)
            <g class="sky-art__float sky-art__float--a">
                <g transform="rotate(-6 120 96)">
                    <rect x="80" y="24" width="80" height="136" rx="20" class="sky-art__card sky-art__card--rim" />
                    <rect x="108" y="32" width="24" height="5" rx="2.5" class="sky-art__line sky-art__line--soft" />
                    @Row(52, "sky-art__accent")
                    @Row(82, "sky-art__warm")
                    @Row(112, "sky-art__mint")
                </g>
            </g>
            <circle cx="164" cy="40" r="15" class="sky-art__accent" />
            <path d="M157.5 40.5l4.4 4.4 8.6-9" class="sky-art__check" />
            break;
    }
</svg>

@code {
    private const string SquirclePath = "M50 0C88.6 0 100 11.4 100 50S88.6 100 50 100 0 88.6 0 50 11.4 0 50 0Z";
    private const string Heart = "M12 21s-7.2-4.5-9.6-8.8C.5 8.8 2.3 4.4 6.4 4c2.2-.2 4 1 5.6 3 1.6-2 3.4-3.2 5.6-3 4.1.4 5.9 4.8 4 8.2C19.2 16.5 12 21 12 21Z";
    private const string Drop = "M4 7c0 3-2 5-4 5s-4-2-4-5c0-2.4 4-7 4-7s4 4.6 4 7Z";
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;

    private readonly string _id = "sm-art-" + Guid.NewGuid().ToString("N")[..8];

    [Parameter] public SkyArtKind Kind { get; set; }
    /// <summary>Width in px at 100% font scale (the height is three quarters of it).</summary>
    [Parameter] public double Size { get; set; } = 200;
    [Parameter] public string? Class { get; set; }

    private string Id(string name) => $"{_id}-{name}";

    private static string Rem(double px) => (px / 16).ToString("0.###", Inv) + "rem";

    private static string N(double value) => value.ToString("0.##", Inv);

    // A soft cloud resting at (x, y): its base line runs from x to x + 152 * scale.
    private RenderFragment Cloud(double x, double y, double scale) => __builder =>
    {
        <g class="sky-art__cloud" transform="@($"translate({N(x)} {N(y)}) scale({N(scale)})")">
            <circle cx="26" cy="16" r="22" />
            <circle cx="66" cy="0" r="32" />
            <circle cx="108" cy="12" r="25" />
            <circle cx="138" cy="22" r="15" />
            <rect x="4" y="12" width="148" height="26" rx="13" />
        </g>
    };

    // A squircle face (person glyph) of 62px at (x, y).
    private RenderFragment Face(double x, double y, string tone) => __builder =>
    {
        var clip = Id($"face-{N(x)}");
        var cx = x + 31;
        <clipPath id="@clip">
            <path d="@SquirclePath" transform="@($"translate({N(x)} {N(y)}) scale(0.62)")" />
        </clipPath>
        <path d="@SquirclePath" transform="@($"translate({N(x)} {N(y)}) scale(0.62)")" class="@tone" />
        <g clip-path="@($"url(#{clip})")" class="sky-art__person">
            <circle cx="@N(cx)" cy="@N(y + 25)" r="10" />
            <ellipse cx="@N(cx)" cy="@N(y + 60)" rx="20" ry="15" />
        </g>
    };

    // A contact row on the phone: a squircle avatar and two lines.
    private RenderFragment Row(double y, string tone) => __builder =>
    {
        <path d="@SquirclePath" transform="@($"translate(92 {N(y)}) scale(0.22)")" class="@tone" />
        <rect x="120" y="@N(y + 4)" width="28" height="5" rx="2.5" class="sky-art__line" />
        <rect x="120" y="@N(y + 13)" width="18" height="4" rx="2" class="sky-art__line sky-art__line--soft" />
    };
}
