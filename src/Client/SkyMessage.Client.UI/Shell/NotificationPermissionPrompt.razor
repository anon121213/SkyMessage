@* Asks once per device for permission to show notifications (Android 13+, iOS, macOS and browsers need it, or
   background messages and incoming calls stay silent). Native apps show the system dialog shortly after the
   signed-in shell appears; browsers only allow it from a tap, so they get a glass card at the top with a bell, the
   button and a dismiss — there as soon as the list is, not dropping in over rows already on screen. It is last in the
   chat list's notice slot (NoticeSlot): while the update or the birthday card shows it does not start at all (nothing
   is remembered, a later start asks), and a card arriving later takes the slot until it goes. Short screens get it as a
   one-row strip with a title of its own ("Включите уведомления"). *@
@inherits UiComponentBase
@inject ILocalNotificationService LocalNotifications
@inject IPermissionService Permissions
@inject IPlatformInfo Platform
@inject IPreferencesStore Preferences
@inject ISettingsService Settings
@inject ILogger<NotificationPermissionPrompt> Logger

@if (_showStrip)
{
    <div class="notify-card chatlist-notice sm-glass sm-glass--strong @(_leaving ? "notify-card--leaving" : null)" role="status">
        <span class="notify-card__disc" aria-hidden="true">
            <Icon Name="@IconNames.BellRing" Size="22" StrokeWidth="2.2" />
        </span>
        <div class="notify-card__body">
            @* The strip (short screens) says it in two words that fit its two lines beside the button. *@
            <div class="notify-card__title">
                <span class="notify-card__title-full">@L["app.notifications.title"]</span>
                <span class="notify-card__title-short">@L["app.notifications.short"]</span>
            </div>
            <div class="notify-card__text">@L["app.notifications.prompt"]</div>
            <div class="notify-card__actions">
                <Button Size="ButtonSize.Small" Icon="@IconNames.Bell" Loading="_busy" OnClick="EnableAsync">@L["app.notifications.enable"]</Button>
            </div>
        </div>
        <IconButton Icon="@IconNames.X" Label="@L["common.close"]" Size="32" Class="notify-card__close" OnClick="DismissAsync" />
    </div>
}

@code {
    /// <summary>Per-device flag in IPreferencesStore: the user has been asked (or dismissed the strip).</summary>
    public const string PromptedKey = "ui.notifications.prompted.v1";

    private const int LeaveMs = 200;
    private bool _showStrip;
    private bool _leaving;
    private bool _busy;
    private bool _checked;

    /// <summary>The chat list's notice slot (one card at a time); null elsewhere.</summary>
    [CascadingParameter] public NoticeSlot? Slot { get; set; }

    /// <summary>Another card has the slot: this one stays away (asked again on a later start).</summary>
    private bool SlotTaken => Slot?.IsTakenBesides(NoticeKind.Notifications) == true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        Slot?.Report(NoticeKind.Notifications, _showStrip);
        if (!firstRender || _checked) return;
        _checked = true;
        try
        {
            // Native apps: let the chat list appear first, a system dialog over a blank screen feels alarming. The
            // browser's card comes with the list instead of dropping in over rows already on screen.
            if (Platform.IsNativeApp) await Task.Delay(1500);
            if (IsDisposed || !Settings.Current.Notifications.Enabled || SlotTaken) return;
            if (!string.IsNullOrEmpty(await Preferences.GetAsync(PromptedKey))) return;
            var state = await Permissions.CheckAsync(AppPermission.Notifications);
            if (state is PermissionState.Granted or PermissionState.Limited or PermissionState.NotApplicable or PermissionState.Restricted) return;
            if (IsDisposed || SlotTaken) return;
            if (Platform.IsNativeApp)
            {
                // Android reports "denied" until the first request, so native apps simply ask once per device.
                await MarkPromptedAsync();
                await LocalNotifications.RequestPermissionAsync();
                return;
            }
            if (state == PermissionState.Unknown)
            {
                _showStrip = true;
                StateHasChanged();
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogDebug(ex, "Notification permission check failed");
        }
    }

    private async Task EnableAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await MarkPromptedAsync();
            await LocalNotifications.RequestPermissionAsync();
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Notification permission request failed");
        }
        finally
        {
            _busy = false;
            await HideAsync();
        }
    }

    private async Task DismissAsync()
    {
        await MarkPromptedAsync();
        await HideAsync();
    }

    // Lifts the card away, then removes it.
    private async Task HideAsync()
    {
        if (!_showStrip || _leaving) return;
        _leaving = true;
        StateHasChanged();
        await Task.Delay(LeaveMs);
        _showStrip = false;
        _leaving = false;
    }

    private async Task MarkPromptedAsync()
    {
        try
        {
            await Preferences.SetAsync(PromptedKey, "1");
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not remember the notification prompt");
        }
    }
}
