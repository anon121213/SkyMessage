@* Shown until settings and the session are restored (no network wait): the sky with the lockup — the «Горизонт» mark
   and the wordmark standing on its horizon, which opens once — after the Android splash (the same mark on the brand
   ground). *@
<div class="boot-splash" aria-busy="true">
    <SkyBackdrop />
    <div class="boot-splash__brand">
        <Logo Size="52" Wordmark="true" Animated="true" />
    </div>
    @if (ShowSpinner)
    {
        <Spinner Size="26" Class="boot-splash__spinner" />
    }
</div>

@code {
    [Parameter] public bool ShowSpinner { get; set; }
}
