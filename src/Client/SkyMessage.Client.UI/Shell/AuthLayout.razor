@* Layout of the signed-out screens (welcome, login, register): the sky with a few restrained, flat decorations — three
   capsule clouds drifting at the edges and a crescent moon by night — and one centered column of content on top. The
   decorations keep clear of the header (the logo and the title): on phones they stay in the lower half and the moon
   leaves the welcome screen's lockup alone; on wide screens they sit beside the column. Pure decoration (aria-hidden):
   still under reduced motion and in data-fx="lite". *@
@inherits LayoutComponentBase
@inject LayoutService Layout

<div class="auth-shell">
    <SkyBackdrop Comet="false" />
    <div class="auth-deco" aria-hidden="true">
        <svg class="auth-deco__moon" viewBox="0 0 64 64" focusable="false">
            <path d="M38 8a24 24 0 1 0 18 40A20 20 0 0 1 38 8Z" />
        </svg>
        <svg class="auth-deco__cloud auth-deco__cloud--1" viewBox="0 0 240 120" focusable="false">@Cloud</svg>
        <svg class="auth-deco__cloud auth-deco__cloud--2" viewBox="0 0 240 120" focusable="false">@Cloud</svg>
        <svg class="auth-deco__cloud auth-deco__cloud--3" viewBox="0 0 240 120" focusable="false">@Cloud</svg>
    </div>
    <div class="auth-shell__scroll">
        <CascadingValue Value="@(new ShellContext(Layout.Mode, ShellPane.Page, false))">
            <main class="auth-shell__column">
                <ErrorBoundary @ref="_boundary">
                    <ChildContent>@Body</ChildContent>
                    <ErrorContent Context="error">
                        <CrashScreen Exception="error" Compact="true" OnRetry="() => _boundary?.Recover()" />
                    </ErrorContent>
                </ErrorBoundary>
            </main>
        </CascadingValue>
    </div>
    <DialogHost />
    <ToastHost />
</div>

@code {
    private ErrorBoundary? _boundary;

    // A flat capsule cloud (a short capsule resting on a long one, the kit's capsule shape); its color comes from the
    // theme. The same construction as the empty-chat art and the Appearance scenes.
    private static readonly RenderFragment Cloud = __builder =>
    {
        <g class="auth-deco__shape">
            <rect x="60" y="25" width="116" height="44" rx="22" />
            <rect x="12" y="51" width="216" height="44" rx="22" />
        </g>
    };
}
