@* A sticker's picture: its WebP preview (≤ 256 px) in panels and grids, the full WebP (≤ 512 px) where it is large (a
   message, the preview). Transparent, so it sits straight on whatever is behind it; no frame, no shadow. *@
@inherits UiComponentBase
@inject IMediaUrlBuilder MediaUrls

@if (Url is { } url)
{
    <img class="sticker-img @Class" src="@url" alt="@Alt" title="@Title" loading="@(Eager ? "eager" : "lazy")" decoding="async" draggable="false"
         data-fade="@(Fade ? "" : null)" />
}
else
{
    <span class="sticker-img sticker-img--empty @Class" aria-hidden="true"></span>
}

@code {
    [Parameter, EditorRequired] public MediaDto? Media { get; set; }
    /// <summary>The full WebP instead of the preview.</summary>
    [Parameter] public bool Full { get; set; }
    [Parameter] public string? Alt { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool Eager { get; set; }
    /// <summary>Fades in once loaded (inside the message list, which marks loaded images).</summary>
    [Parameter] public bool Fade { get; set; }
    [Parameter] public string? Class { get; set; }

    private string? Url => Media is not { Status: MediaStatus.Ready } media
        ? null
        : Full || !media.HasThumbnail ? MediaUrls.ContentUrl(media) : MediaUrls.ThumbnailUrl(media.Id);

    protected override void OnInitialized() => RenderOn(h => MediaUrls.Changed += h, h => MediaUrls.Changed -= h);
}
