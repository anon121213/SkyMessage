@* The Stickers tab of the composer's panel: a strip to jump between «Недавние», «Избранные» and every installed pack —
   the emoji picker's capsule track and gliding pill, each pack's face its first sticker — with «Создать набор» and the
   settings pinned at its end; then all of them in one scroll with their names as sticky chips. A pack's stickers are
   drawn once it comes near the visible part (a hundred packs of 120 would be thousands of cells): until then its place
   is kept by an empty block of its height. A tap sends at once; a hold (or right-click) shows the sticker large with
   favorite / send / its pack (js/stickers.js holds every cell through one delegated listener). *@
@inherits UiComponentBase
@implements IAsyncDisposable
@inject IStickerStore Stickers
@inject DialogService Dialogs
@inject NavigationService Nav
@inject ToastService Toasts
@inject HapticFeedback Haptics
@inject AppJs Js
@inject IJSRuntime JS

<div class="spanel" style="--panel-h:@Height">
    @if (!CanSend)
    {
        <div class="xempty">
            <span class="xempty__tile" aria-hidden="true"><Icon Name="@IconNames.Lock" Size="22" /></span>
            <div class="xempty__text">@L["stickers.panel.noMedia"]</div>
        </div>
    }
    else if (_sections.Count == 0)
    {
        <div class="xempty">
            <span class="xempty__tile" aria-hidden="true"><Icon Name="@IconNames.SmilePlus" Size="24" /></span>
            <div class="xempty__title">@L["stickers.panel.emptyTitle"]</div>
            <div class="xempty__text">@L["stickers.panel.emptyText"]</div>
            <div class="xempty__actions">
                <Button Icon="@IconNames.Plus" Size="ButtonSize.Small" OnClick="CreateAsync">@L["stickers.settings.create"]</Button>
            </div>
        </div>
    }
    else
    {
        <div class="spanel__strip" data-no-swipe-back>
            <div class="spanel__strip-scroll" @ref="_strip">
                <div class="spanel__track" role="tablist" aria-label="@L["stickers.panel.stickers"]" style="--tabs:@_sections.Count;--tab:@ActiveIndex">
                    <span class="spanel__pill" aria-hidden="true"></span>
                    @foreach (var part in _sections)
                    {
                        var key = part.Key;
                        var active = key == _active;
                        <button type="button" role="tab" aria-selected="@(active ? "true" : "false")" title="@part.Title" aria-label="@part.Title"
                                class="spanel__tab @(active ? "spanel__tab--active" : null)" data-strip-key="@key" @onclick="() => JumpAsync(key)">
                            @if (part.Icon is { } icon)
                            {
                                <Icon Name="@icon" Size="18" />
                            }
                            else if (part.Cover is { } cover)
                            {
                                <span class="spanel__tab-face"><StickerImage Media="cover.Media" Eager="true" /></span>
                            }
                        </button>
                    }
                </div>
            </div>
            <div class="spanel__tools">
                <button type="button" class="spanel__tool" title="@L["stickers.settings.create"]" aria-label="@L["stickers.settings.create"]" @onclick="CreateAsync">
                    <Icon Name="@IconNames.Plus" Size="19" />
                </button>
                <button type="button" class="spanel__tool" title="@L["stickers.panel.manage"]" aria-label="@L["stickers.panel.manage"]" @onclick="Manage">
                    <Icon Name="@IconNames.Settings2" Size="18" />
                </button>
            </div>
        </div>
        <div class="spanel__scroll" @ref="_scroll">
            @foreach (var part in _sections)
            {
                var item = part;
                <section class="spanel__section" @key="item.Key" @ref="_sectionRefs[item.Key]" aria-label="@item.Title">
                    <div class="spanel__heading"><span dir="auto">@item.Title</span></div>
                    @if (item.Stickers is not { } stickers)
                    {
                        <div class="spanel__grid" aria-hidden="true">
                            @for (var i = 0; i < Math.Min(10, Math.Max(1, item.ExpectedCount)); i++)
                            {
                                <span class="spanel__cell spanel__cell--wait"><Skeleton Shape="SkeletonShape.Rect" Width="100%" Height="100%" /></span>
                            }
                        </div>
                    }
                    else if (!_drawn.Contains(item.Key))
                    {
                        @* Its height (five columns, as the panel's width gives them), so nothing below moves when it is drawn. *@
                        <div class="spanel__later" style="--rows:@((stickers.Count + 4) / 5)" aria-hidden="true"></div>
                    }
                    else
                    {
                        <div class="spanel__grid">
                            @foreach (var sticker in stickers)
                            {
                                var s = sticker;
                                <button type="button" class="spanel__cell" data-hold="@s.Id" title="@StickerUi.EmojiLine(s)" aria-label="@StickerUi.EmojiLine(s)"
                                        @onclick="() => PickAsync(s)">
                                    <StickerImage Media="s.Media" />
                                </button>
                            }
                        </div>
                    }
                </section>
            }
        </div>
    }
</div>

@code {
    private const string RecentKey = "recent";
    private const string FavoritesKey = "favorites";
    private const string ModulePath = "./_content/SkyMessage.Client.UI/js/stickers.js";
    /// <summary>Drawn at once from the top: about two screens of stickers.</summary>
    private const int DrawnAtOnce = 60;

    private sealed record PanelSection(string Key, string Title, string? Icon, StickerDto? Cover, IReadOnlyList<StickerDto>? Stickers, int ExpectedCount);

    private readonly Dictionary<string, ElementReference> _sectionRefs = [];
    private readonly HashSet<Guid> _requested = [];
    private readonly HashSet<string> _drawn = [];
    private readonly HashSet<string> _observed = [];
    private readonly HashSet<string> _inBand = [];
    private DateTimeOffset _jumpedUntil;
    private ElementReference _strip;
    private ElementReference _scroll;
    private JsModule? _module;
    private JsObject? _hold;
    private JsObject? _wheel;
    private JsHandle? _observer;
    private JsHandle? _nearObserver;
    private DotNetObjectReference<StickerPanel>? _self;
    private string? _active;
    private List<PanelSection> _sections = [];
    private IReadOnlyList<StickerDto>? _recent;
    private string _signature = "";
    private bool _attached;

    /// <summary>Tap on a sticker: send it.</summary>
    [Parameter] public EventCallback<StickerDto> OnPick { get; set; }
    /// <summary>The chat allows media (stickers are media in groups' permissions).</summary>
    [Parameter] public bool CanSend { get; set; } = true;
    /// <summary>The panel's own height (the strip and the scroll share it).</summary>
    [Parameter] public string Height { get; set; } = "17rem";
    /// <summary>The panel is going (a pack or the settings opened): the composer closes it.</summary>
    [Parameter] public EventCallback OnLeave { get; set; }

    private int ActiveIndex => Math.Max(0, _sections.FindIndex(s => s.Key == _active));

    protected override void OnInitialized()
    {
        Stickers.Changed += OnStickersChanged;
        OnDispose(() => Stickers.Changed -= OnStickersChanged);
        Build();
        // The first screens' worth is drawn at once; the rest as the scroll comes near it.
        var count = 0;
        foreach (var section in _sections)
        {
            if (count >= DrawnAtOnce) break;
            _drawn.Add(section.Key);
            count += section.Stickers?.Count ?? section.ExpectedCount;
        }
    }

    private void OnStickersChanged() => InvokeAsync(async () =>
    {
        if (IsDisposed) return;
        // Only what the panel shows counts: a sticker just sent (recent ones keep their order while it is open) or a
        // GIF saved elsewhere does not redraw hundreds of cells.
        if (!Build()) return;
        // The scroll went away with the last pack: it is bound again when packs come back.
        if (_sections.Count == 0 && _attached) await DetachAsync();
        StateHasChanged();
    });

    /// <summary>
    /// Recent, favorites, then my packs in my order; packs whose stickers are not here yet are asked for. False when
    /// nothing the panel shows changed.
    /// </summary>
    private bool Build()
    {
        var state = Stickers.State;
        var sections = new List<PanelSection>();
        // Recent stickers keep the order they had when the panel opened: sending one must not reshuffle the row under the
        // finger (the next opening shows the new order).
        if (_recent is null || _recent.Count == 0) _recent = state.Recent;
        var recent = _recent.Where(s => state.Recent.Any(r => r.Id == s.Id)).ToList();
        if (recent.Count > 0)
            sections.Add(new PanelSection(RecentKey, L["stickers.panel.recent"], IconNames.Clock, null, recent, recent.Count));
        if (state.Favorites.Count > 0)
            sections.Add(new PanelSection(FavoritesKey, L["stickers.panel.favorites"], IconNames.Star, null, state.Favorites, state.Favorites.Count));
        foreach (var installed in state.Installed)
        {
            var pack = Stickers.GetPack(installed.Id);
            if (pack is null && _requested.Add(installed.Id)) _ = LoadPackAsync(installed.Id);
            if (pack is { Stickers.Count: 0 } || (pack is null && installed.StickerCount == 0)) continue;
            sections.Add(new PanelSection(installed.Id.ToString("N"), installed.Title, null, pack?.Stickers.FirstOrDefault() ?? installed.Cover,
                pack?.Stickers, installed.StickerCount));
        }

        var signature = string.Join('|', sections.Select(s =>
            $"{s.Key}:{s.Title}:{s.Cover?.Id}:{(s.Stickers is null ? "-" : string.Join(',', s.Stickers.Select(x => $"{x.Id}{x.Emoji.FirstOrDefault()}")))}"));
        var changed = signature != _signature;
        _signature = signature;
        _sections = sections;
        if (_active is null || sections.All(s => s.Key != _active)) _active = sections.FirstOrDefault()?.Key;
        return changed;
    }

    private async Task LoadPackAsync(Guid packId)
    {
        try
        {
            await Stickers.LoadPackAsync(packId);
        }
        catch (Exception ex) when (ex is ApiException or OperationCanceledException)
        {
            // Shown again from the store's own refresh; a deleted pack leaves the state.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!CanSend || _sections.Count == 0) return;
        if (!_attached)
        {
            _attached = true;
            _self ??= DotNetObjectReference.Create(this);
            _module ??= new JsModule(JS, ModulePath);
            _hold = await _module.AttachAsync("attachHold", _scroll, _self);
            _wheel = await _module.AttachAsync("attachStripWheel", _strip);
            _observer = await Js.CreateIntersectionObserverAsync(_scroll, _self, nameof(OnSectionsVisible), "0px 0px -70% 0px");
            _nearObserver = await Js.CreateIntersectionObserverAsync(_scroll, _self, nameof(OnSectionsNear), "600px 0px 600px 0px");
        }
        // Sections that appear later (a pack installed while the panel is open) are observed too.
        if (_observer is null || _nearObserver is null) return;
        foreach (var section in _sections)
        {
            if (_observed.Contains(section.Key) || !_sectionRefs.TryGetValue(section.Key, out var element)) continue;
            _observed.Add(section.Key);
            await _observer.InvokeVoidAsync("observe", element, section.Key);
            await _nearObserver.InvokeVoidAsync("observe", element, section.Key);
        }
    }

    private async Task DetachAsync()
    {
        _attached = false;
        _observed.Clear();
        _inBand.Clear();
        _sectionRefs.Clear();
        if (_hold is not null) await _hold.DisposeAsync();
        if (_wheel is not null) await _wheel.DisposeAsync();
        if (_observer is not null) await _observer.DisposeAsync();
        if (_nearObserver is not null) await _nearObserver.DisposeAsync();
        _hold = null;
        _wheel = null;
        _observer = null;
        _nearObserver = null;
    }

    /// <summary>
    /// The sections in the top band of the scroll (changes come one by one, so the band's contents are kept here): the
    /// first of them is the one being looked at. Right after a jump from the strip the jump's target stays active (its
    /// scroll leaves the previous section's last pixels in the band).
    /// </summary>
    [JSInvokable]
    public void OnSectionsVisible(VisibilityChange[] changes)
    {
        foreach (var change in changes)
        {
            if (change.Visible) _inBand.Add(change.Key);
            else _inBand.Remove(change.Key);
        }
        if (DateTimeOffset.UtcNow < _jumpedUntil) return;
        var top = _sections.FirstOrDefault(s => _inBand.Contains(s.Key))?.Key;
        if (top is null || top == _active) return;
        _active = top;
        RequestRender();
        _ = RevealActiveAsync();
    }

    /// <summary>Sections within a screen or so of the visible part: their stickers are drawn.</summary>
    [JSInvokable]
    public void OnSectionsNear(VisibilityChange[] changes)
    {
        var added = false;
        foreach (var change in changes)
            if (change.Visible) added |= _drawn.Add(change.Key);
        if (added) RequestRender();
    }

    private async Task RevealActiveAsync()
    {
        if (_module is null || _active is null) return;
        await Task.Yield();
        await _module.InvokeVoidAsync("revealInStrip", _strip, _active);
    }

    private async Task JumpAsync(string key)
    {
        _active = key;
        _jumpedUntil = DateTimeOffset.UtcNow.AddMilliseconds(600);
        if (_drawn.Add(key))
        {
            // Drawn first, so the scroll lands where its stickers are.
            StateHasChanged();
            await Task.Yield();
        }
        if (_module is not null && _sectionRefs.TryGetValue(key, out var section)) await _module.InvokeVoidAsync("scrollToSection", _scroll, section);
        await RevealActiveAsync();
    }

    private async Task PickAsync(StickerDto sticker)
    {
        Haptics.Tap();
        await OnPick.InvokeAsync(sticker);
    }

    /// <summary>A cell was held (or right-clicked): the large preview.</summary>
    [JSInvokable]
    public Task OnHold(string key) => InvokeAsync(async () =>
    {
        if (!Guid.TryParse(key, out var id)) return;
        var sticker = _sections.SelectMany(s => s.Stickers ?? []).FirstOrDefault(s => s.Id == id);
        if (sticker is null) return;
        Haptics.LongPress();
        var answer = await StickerPreviewDialog.ShowAsync(Dialogs, sticker, canSend: true, showPack: true);
        if (answer == "send") await PickAsync(sticker);
        else if (answer == "pack")
        {
            await StickerPackSheet.ShowAsync(Dialogs, sticker.PackId);
        }
    });

    private async Task CreateAsync()
    {
        await OnLeave.InvokeAsync();
        await StickerFlows.CreatePackAsync(L, Dialogs, Stickers, Nav, Toasts);
    }

    private async Task Manage()
    {
        await OnLeave.InvokeAsync();
        Nav.NavigateTo(StickerUi.SettingsPath);
    }

    public async ValueTask DisposeAsync()
    {
        await DetachAsync();
        if (_module is not null) await _module.DisposeAsync();
        _self?.Dispose();
        Dispose();
    }
}
