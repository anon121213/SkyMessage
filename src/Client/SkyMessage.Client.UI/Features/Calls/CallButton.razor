@* Call control: a glass circle with a caption (mute, camera, speaker…), a mint orb to answer, a rose one to hang up or
   decline. A changed icon turns in with a small rotate/scale; Glow (answer / decline while a call rings) sends a thin
   ring out of the orb and makes the answer orb hop like a ringing phone. Compact: a small circle without caption (call
   bar). No haptic on a plain tap (docs/MOTION.md). *@

<button type="button" class="call-btn call-btn--@Kind.ToString().ToLowerInvariant() @(Active ? "is-active" : null) @(Compact ? "call-btn--compact" : null) @(Glow ? "call-btn--glow" : null) @Class"
        aria-label="@Label" title="@Label" aria-pressed="@(Toggle ? (Active ? "true" : "false") : null)" disabled="@Disabled"
        @onclick="OnClick" @onclick:stopPropagation="true">
    <span class="call-btn__circle">
        @if (Glow)
        {
            <span class="call-btn__ring" aria-hidden="true"></span>
        }
        @* Keyed by the icon: a new icon is a new element, so only a change plays the turn-in (not the first render). *@
        <span @key="Icon" class="call-btn__icon @(_swapped ? "is-swapped" : null)"><Icon Name="@Icon" Size="@(Compact ? 19 : 26)" StrokeWidth="@(Compact ? 2.2 : 2)" /></span>
    </span>
    @if (!Compact)
    {
        <span class="call-btn__label">@Label</span>
    }
</button>

@code {
    private string? _shownIcon;
    private bool _swapped;

    [Parameter, EditorRequired] public string Icon { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public CallButtonKind Kind { get; set; } = CallButtonKind.Normal;
    /// <summary>Highlighted state (e.g. microphone off): the glass turns into a white circle.</summary>
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Toggle { get; set; }
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Small circle without caption (minimized bar).</summary>
    [Parameter] public bool Compact { get; set; }
    /// <summary>A thin ring opening out of the orb (answer / decline while ringing); the answer orb also hops.</summary>
    [Parameter] public bool Glow { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    protected override void OnParametersSet()
    {
        if (_shownIcon is not null && _shownIcon != Icon) _swapped = true;
        _shownIcon = Icon;
    }
}
