@* Page frame of a settings section: header with back (phones) or none (next to the menu on wide screens). The cards
   rise in one after another when the section opens (.sm-stagger, first render only). *@

<AppPage Title="@Title" Subtitle="@Subtitle" Back="@(Context?.InSplit == true ? false : null)" BackFallback="@BackPath" Padded="true"
         Actions="Actions" Footer="Footer">
    <div class="settings-stack sm-stagger">
        @ChildContent
    </div>
</AppPage>

@code {
    [CascadingParameter] public SettingsContext? Context { get; set; }

    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string BackPath => Context is { } context ? SettingsCatalog.ParentPathOf(context.Key) : "/settings";
}
