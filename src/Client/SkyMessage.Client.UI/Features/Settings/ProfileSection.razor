@* Edit my profile: photo (from the gallery or the camera framed in the crop editor, or an emoji on a color; the photo
   opens my avatar history), name, username with a live availability check (free / taken icons pop in), bio, up to
   three links; my look (profile color, cover — saved at once and previewed on the photo block), my birthday; my
   shareable link. *@
@inherits UiComponentBase
@implements IAsyncDisposable
@inject IAuthService Auth
@inject ISkyApi Api
@inject AvatarUploader Avatars
@inject IMediaUrlBuilder MediaUrls
@inject ILinkBuilder Links
@inject ShareHelper Share
@inject DialogService Dialogs
@inject ToastService Toasts
@inject NavigationService Nav
@inject AvatarFlows AvatarSources
@inject AvatarOverlays AvatarViewer
@inject ThemeService Theme
@inject FormatService Format
@inject ILogger<ProfileSection> Logger

<SettingsScaffold Title="@L["settings.profile.title"]">
    <Footer>
        <Button Block="true" Size="ButtonSize.Large" Loading="_saving" Disabled="@(!CanSave)" OnClick="SaveAsync">@L["common.save"]</Button>
    </Footer>
    <ChildContent>
        @if (Auth.Me is { } me)
        {
            var cover = CoverStyle(me);
            <div class="profile-photo @(cover is null ? null : "profile-photo--cover")" style="@ProfileLook.TintStyle(me.ProfileColor)">
                @if (cover is not null)
                {
                    <div class="profile-photo__cover @(me.Cover?.MediaId is not null ? "profile-photo__cover--photo" : null)" style="@cover" aria-hidden="true"></div>
                }
                <div class="profile-photo__frame">
                    <span class="profile-photo__ring" aria-hidden="true"></span>
                    <Avatar Url="@(_previewUrl ?? MediaUrls.AvatarUrl(me.AvatarMediaId))" Name="@(string.IsNullOrWhiteSpace(_name) ? me.DisplayName : _name)" Seed="me.Id" Size="120"
                            OnClick="OpenPhotoAsync" />
                    @if (_uploading)
                    {
                        <div class="profile-photo__progress">
                            <ProgressRing Value="_progress" Size="120" Indeterminate="@(_progress <= 0)" OnCancel="CancelUpload" CancelLabel="@L["common.cancel"]" />
                        </div>
                    }
                </div>
                <div class="sm-row sm-row--wrap sm-gap-s profile-photo__actions">
                    <Button Variant="ButtonVariant.Tonal" Size="ButtonSize.Small" Icon="@IconNames.Camera" Disabled="_uploading" OnClick="ChangePhotoAsync">
                        @(me.AvatarMediaId is null ? L["settings.profile.photo.add"] : L["settings.profile.photo.change"])
                    </Button>
                    @if (me.AvatarMediaId is not null && !_uploading)
                    {
                        <Button Variant="ButtonVariant.DangerGhost" Size="ButtonSize.Small" Icon="@IconNames.Trash2" OnClick="RemovePhotoAsync">@L["settings.profile.photo.remove"]</Button>
                    }
                </div>
            </div>

            <Section>
                <div class="profile-form sm-p-m sm-col sm-gap-m">
                    <TextField Value="@_name" ValueChanged="OnNameChanged" Label="@L["settings.profile.name"]" MaxLength="Limits.DisplayNameMaxLength" ShowCounter="true"
                               Error="@_nameError" Autocomplete="name" />
                    <TextField Value="@_username" ValueChanged="OnUsernameChanged" Label="@L["settings.profile.username"]" Prefix="@("@")"
                               MaxLength="Limits.UsernameMaxLength" Autocomplete="off" Autocapitalize="off" Spellcheck="false"
                               Error="@_usernameError" Success="@_usernameOk" Hint="@(_usernameError is null && _usernameOk is null ? L["settings.profile.usernameHint"] : null)">
                        <Trailing>
                            @if (_checking)
                            {
                                <Spinner Size="18" />
                            }
                            else if (_usernameOk is not null)
                            {
                                <Icon Name="@IconNames.CircleCheck" Size="20" Class="sm-success-text profile-form__check" />
                            }
                            else if (_usernameRefused)
                            {
                                <Icon Name="@IconNames.CircleX" Size="20" Class="sm-danger-text profile-form__check" />
                            }
                        </Trailing>
                    </TextField>
                    <TextArea Value="@_bio" ValueChanged="OnBioChanged" Label="@L["settings.profile.bio"]" Placeholder="@L["settings.profile.bioPlaceholder"]"
                              Rows="2" MaxRows="6" MaxLength="Limits.BioMaxLength" ShowCounter="true" />
                </div>
            </Section>

            <Section Title="@L["customize.links"]" Footer="@L["customize.links.hint"]">
                <div class="profile-links sm-p-m sm-col sm-gap-m">
                    @for (var i = 0; i < _links.Count; i++)
                    {
                        var index = i;
                        var link = _links[i];
                        <div @key="link" class="profile-links__item">
                            <div class="profile-links__fields">
                                <TextField Value="@link.Url" ValueChanged="v => SetLinkUrl(index, v)" Label="@L["customize.links.url"]"
                                           Placeholder="@L["customize.links.urlPlaceholder"]" Type="url" InputMode="url" Autocapitalize="off" Spellcheck="false"
                                           MaxLength="Limits.ProfileLinkUrlMaxLength" Error="@link.Error" Icon="@IconNames.Link" />
                                <TextField Value="@link.Title" ValueChanged="v => SetLinkTitle(index, v)" Label="@L["customize.links.title"]"
                                           Placeholder="@L["customize.links.titlePlaceholder"]" MaxLength="Limits.ProfileLinkTitleMaxLength" />
                            </div>
                            <IconButton Icon="@IconNames.X" Label="@L["customize.links.remove"]" Size="38" Class="profile-links__remove" OnClick="() => RemoveLink(index)" />
                        </div>
                    }
                    @if (_links.Count < Limits.ProfileLinksMax)
                    {
                        <Button Variant="ButtonVariant.Tonal" Size="ButtonSize.Small" Icon="@IconNames.Plus" Class="profile-links__add" OnClick="AddLink">@L["customize.links.add"]</Button>
                    }
                </div>
            </Section>

            <Section Title="@L["customize.section"]" Footer="@L["customize.color.hint"]">
                <div class="profile-look sm-p-m">
                    <div class="sm-overline profile-look__label">@L["customize.color"]</div>
                    <div class="sm-swatches profile-look__swatches">
                        <ColorSwatch Color="var(--sm-surface-3)" RingColor="var(--sm-text-3)" Label="@L["customize.color.none"]" Selected="@(me.ProfileColor is null)"
                                     Class="profile-look__none" OnClick="() => SetColorAsync(null)">
                            @if (me.ProfileColor is not null)
                            {
                                <Icon Name="@IconNames.Ban" />
                            }
                        </ColorSwatch>
                        @foreach (var key in ProfileStyle.Colors)
                        {
                            if (ProfileLook.Accent(key) is not { } accent) continue;
                            <ColorSwatch @key="key" Color="@accent.Gradient" RingColor="@accent.Hex" Label="@L[accent.NameKey]" Selected="@(me.ProfileColor == key)"
                                         OnClick="() => SetColorAsync(key)" />
                        }
                    </div>
                    <div class="sm-overline profile-look__label">@L["customize.cover"]</div>
                    <div class="profile-look__covers">
                        <button type="button" class="profile-look__cover profile-look__cover--none @(me.Cover is null ? "is-selected" : null)"
                                aria-pressed="@(me.Cover is null ? "true" : "false")" @onclick="() => SetCoverAsync(null)">
                            <span class="profile-look__tile"><Icon Name="@IconNames.Ban" /></span>
                            <span class="profile-look__name">@L["customize.cover.none"]</span>
                        </button>
                        @foreach (var key in ProfileStyle.CoverGradients)
                        {
                            if (!ProfileLook.IsCover(key)) continue;
                            var selected = me.Cover?.Gradient == key;
                            <button @key="key" type="button" class="profile-look__cover @(selected ? "is-selected" : null)" aria-pressed="@(selected ? "true" : "false")"
                                    @onclick="() => SetCoverAsync(key)">
                                <span class="profile-look__tile" style="@($"background:{ProfileLook.CoverCss(key, Theme.IsDark)}")"></span>
                                <span class="profile-look__name">@L[ProfileLook.CoverNameKey(key)]</span>
                            </button>
                        }
                        <button type="button" class="profile-look__cover @(me.Cover?.MediaId is not null ? "is-selected" : null)" disabled="@_coverBusy"
                                aria-pressed="@(me.Cover?.MediaId is not null ? "true" : "false")" @onclick="PickCoverPhotoAsync">
                            <span class="profile-look__tile profile-look__tile--photo" style="@CoverTileStyle(me)">
                                @if (_coverBusy)
                                {
                                    <Spinner Size="20" />
                                }
                                else if (me.Cover?.MediaId is null)
                                {
                                    <Icon Name="@IconNames.ImagePlus" />
                                }
                            </span>
                            <span class="profile-look__name">@L["customize.cover.photo"]</span>
                        </button>
                    </div>
                    @if (me.Cover?.MediaId is not null)
                    {
                        <p class="profile-look__note">@L["customize.cover.photoHint"]</p>
                    }
                </div>
            </Section>

            <Section Title="@L["birthday.title"]" Footer="@BirthdayFooter(me)">
                <ListItem Icon="@IconNames.Calendar" IconColor="@SettingsTones.Peach"
                          Title="@(me.Birthday is { } birthday ? ProfileLook.BirthdayText(Format, birthday) : L["birthday.add"])"
                          Meta="@(me.Birthday is null ? L["birthday.none"] : null)" Chevron="true" OnClick="EditBirthdayAsync" />
                <ListItem Icon="@IconNames.Eye" IconColor="@SettingsTones.Violet" Title="@L["birthday.whoSeesTitle"]"
                          Meta="@LevelName(me.Privacy.Birthday ?? PrivacyLevel.Contacts)" Chevron="true" OnClick="OpenPrivacy" />
            </Section>

            <Section Title="@L["settings.profile.link"]" Footer="@L["settings.profile.linkHint"]">
                <ListItem Icon="@IconNames.Link" IconColor="@SettingsTones.Violet" Title="@Links.ProfileLink(me.Username)" Multiline="true" OnClick="CopyLinkAsync">
                    <Trailing>
                        <IconButton Icon="@IconNames.Share2" Label="@L["common.share"]" StopPropagation="true" OnClick="ShareLinkAsync" />
                    </Trailing>
                </ListItem>
                <ListItem Icon="@IconNames.Smartphone" IconColor="@SettingsTones.Mint" Title="@L["settings.phone.title"]"
                          Meta="@(string.IsNullOrEmpty(me.PhoneNumber) ? L["settings.phone.none.short"] : PhoneFormat.Display(me.PhoneNumber))"
                          Chevron="true" OnClick="OpenPhone" />
            </Section>
        }
    </ChildContent>
</SettingsScaffold>

@code {
    private static readonly System.Text.RegularExpressions.Regex UsernameRegex = new(Limits.UsernamePattern);

    private string _name = "";
    private string _username = "";
    private string _bio = "";
    private bool _dirty;
    private string? _nameError;
    private string? _usernameError;
    private string? _usernameOk;
    private bool _checking;
    // The server said no (taken or reserved), as opposed to a format error while typing.
    private bool _usernameRefused;
    private bool _usernameValid = true;
    private bool _saving;
    private bool _uploading;
    private double _progress;
    private string? _previewUrl;
    private CancellationTokenSource? _checkCts;
    private CancellationTokenSource? _uploadCts;
    private List<LinkDraft> _links = [];
    private bool _coverBusy;
    private bool _lookBusy;

    /// <summary>A link being edited (its own object, so rows keep their state while others are removed).</summary>
    private sealed class LinkDraft
    {
        public string Url { get; set; } = "";
        public string Title { get; set; } = "";
        public string? Error { get; set; }
    }

    private bool CanSave
    {
        get
        {
            if (Auth.Me is not { } me || _saving || _checking || !_usernameValid) return false;
            if (string.IsNullOrWhiteSpace(_name)) return false;
            if (_links.Any(l => l.Error is not null)) return false;
            return _name.Trim() != me.DisplayName
                   || !string.Equals(_username.Trim().TrimStart('@'), me.Username, StringComparison.Ordinal)
                   || (_bio ?? "").Trim() != (me.Bio ?? "")
                   || LinksChanged(me);
        }
    }

    protected override void OnInitialized()
    {
        LoadFromMe();
        Auth.Changed += OnAuthChanged;
        OnDispose(() => Auth.Changed -= OnAuthChanged);
        RenderOn(h => MediaUrls.Changed += h, h => MediaUrls.Changed -= h);
        RenderOn(h => Theme.Changed += h, h => Theme.Changed -= h);
    }

    private void OnAuthChanged() => _ = InvokeAsync(() =>
    {
        // Another device (or this one) changed the profile: show it unless the user is editing.
        if (!_dirty) LoadFromMe();
        StateHasChanged();
    });

    private void LoadFromMe()
    {
        if (Auth.Me is not { } me) return;
        _name = me.DisplayName;
        _username = me.Username;
        _bio = me.Bio ?? "";
        _links = me.Links.Select(l => new LinkDraft { Url = l.Url, Title = l.Title ?? "" }).ToList();
        _usernameError = null;
        _usernameOk = null;
        _usernameRefused = false;
        _usernameValid = true;
    }

    private void OnNameChanged(string value)
    {
        _name = value;
        _dirty = true;
        _nameError = string.IsNullOrWhiteSpace(value) ? L["settings.profile.nameRequired"] : null;
    }

    private void OnBioChanged(string value)
    {
        _bio = value;
        _dirty = true;
    }

    private void OnUsernameChanged(string value)
    {
        _username = value;
        _dirty = true;
        _usernameOk = null;
        _usernameError = null;
        _usernameRefused = false;
        _checkCts?.Cancel();
        var candidate = value.Trim().TrimStart('@');
        if (Auth.Me is { } me && string.Equals(candidate, me.Username, StringComparison.Ordinal))
        {
            _usernameValid = true;
            _checking = false;
            return;
        }
        if (!UsernameRegex.IsMatch(candidate))
        {
            _usernameValid = false;
            _checking = false;
            _usernameError = L.Error(ErrorCodes.UsernameInvalid);
            return;
        }
        _usernameValid = false;
        _checking = true;
        var cts = _checkCts = new CancellationTokenSource();
        _ = CheckUsernameAsync(candidate, cts.Token);
    }

    /// <summary>username_invalid for a well-formed name means a reserved one: the format rules would not explain it.</summary>
    private string UsernameRefusedText(string? code, string candidate) =>
        code == ErrorCodes.UsernameInvalid && UsernameRegex.IsMatch(candidate) ? L["auth.username.reserved"] : L.Error(code);

    private async Task CheckUsernameAsync(string candidate, CancellationToken ct)
    {
        try
        {
            await Task.Delay(450, ct);
            var result = await Auth.CheckUsernameAsync(candidate, ct);
            if (ct.IsCancellationRequested) return;
            _usernameValid = result.Available;
            _usernameRefused = !result.Available;
            _usernameOk = result.Available ? L["settings.profile.usernameFree"] : null;
            _usernameError = result.Available ? null : UsernameRefusedText(result.ErrorCode ?? ErrorCodes.UsernameTaken, candidate);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            // Offline: let the server decide on save.
            Logger.LogDebug(ex, "Username check failed");
            _usernameValid = true;
        }
        _checking = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveAsync()
    {
        if (Auth.Me is not { } me || !CanSave) return;
        var name = _name.Trim();
        var username = _username.Trim().TrimStart('@');
        var bio = (_bio ?? "").Trim();
        var request = new UpdateProfileRequest
        {
            DisplayName = name != me.DisplayName ? name : null,
            Username = !string.Equals(username, me.Username, StringComparison.Ordinal) ? username : null,
            Bio = bio != (me.Bio ?? "") ? bio : null,
            Links = LinksChanged(me) ? CleanLinks() : null,
        };
        _saving = true;
        try
        {
            var updated = await Api.UpdateProfileAsync(request);
            Auth.UpdateMe(updated);
            _dirty = false;
            LoadFromMe();
            Toasts.Success(L["settings.profile.saved"]);
        }
        catch (ApiException ex) when (ex.Code is ErrorCodes.UsernameTaken or ErrorCodes.UsernameInvalid)
        {
            _usernameError = UsernameRefusedText(ex.Code, username);
            _usernameRefused = true;
            _usernameValid = false;
        }
        catch (Exception ex)
        {
            Toasts.Error(ex);
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>The photo: my avatar history when I have photos, else a new one.</summary>
    private async Task OpenPhotoAsync()
    {
        if (Auth.Me is { AvatarMediaId: not null } me) AvatarViewer.ViewMine(me.AvatarMediaId);
        else await ChangePhotoAsync();
    }

    private async Task ChangePhotoAsync()
    {
        var options = AvatarSources.SourceOptions().ToList();
        if (Auth.Me?.AvatarMediaId is not null)
            options.Add(new ChoiceOption<string>("view", L["avatar.choose.view"]) { Icon = IconNames.Images });
        var choice = await Dialogs.ChooseAsync(L["avatar.choose.title"], options);
        if (choice is null) return;
        if (choice.Value == "view")
        {
            AvatarViewer.ViewMine(Auth.Me?.AvatarMediaId);
            return;
        }
        PickedPhoto? photo;
        try
        {
            photo = await AvatarSources.MakeAsync(choice.Value);
        }
        catch (Exception ex)
        {
            Toasts.Error(ex);
            return;
        }
        if (photo is null) return;
        _previewUrl = photo.PreviewUrl;
        _uploading = true;
        _progress = 0;
        var cts = _uploadCts = new CancellationTokenSource();
        StateHasChanged();
        try
        {
            var progress = new Progress<double>(p =>
            {
                _progress = p;
                RequestRender();
            });
            var media = await Avatars.UploadAsync(photo, progress, cts.Token);
            var updated = await Api.SetAvatarAsync(media.Id, cts.Token);
            Auth.UpdateMe(updated);
            Toasts.Success(L["settings.profile.photo.saved"]);
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Toasts.Error(ex);
        }
        finally
        {
            _uploading = false;
            _previewUrl = null;
            _uploadCts = null;
        }
    }

    private void CancelUpload() => _uploadCts?.Cancel();

    private async Task RemovePhotoAsync()
    {
        if (!await Dialogs.ConfirmAsync(L["settings.profile.photo.removeConfirm"], null, L["settings.profile.photo.remove"], danger: true)) return;
        try
        {
            var updated = await Api.RemoveAvatarAsync();
            Auth.UpdateMe(updated);
        }
        catch (Exception ex)
        {
            Toasts.Error(ex);
        }
    }

    private async Task CopyLinkAsync()
    {
        if (Auth.Me is { } me) await Share.CopyAsync(Links.ProfileLink(me.Username), L["common.linkCopied"]);
    }

    private async Task ShareLinkAsync()
    {
        if (Auth.Me is { } me) await Share.ShareAsync(Links.ProfileLink(me.Username), me.DisplayName);
    }

    private void OpenPhone() => Nav.NavigateTo(SettingsRoutes.PathOf(SettingsRoutes.Phone));

    private void OpenPrivacy() => Nav.NavigateTo(SettingsRoutes.PathOf(SettingsRoutes.Privacy));

    // ---- Links ----

    private void AddLink()
    {
        if (_links.Count >= Limits.ProfileLinksMax) return;
        _links.Add(new LinkDraft());
        _dirty = true;
    }

    private void RemoveLink(int index)
    {
        if (index < 0 || index >= _links.Count) return;
        _links.RemoveAt(index);
        _dirty = true;
    }

    private void SetLinkUrl(int index, string value)
    {
        var link = _links[index];
        link.Url = value;
        link.Error = string.IsNullOrWhiteSpace(value) || ProfileStyle.NormalizeLinkUrl(value) is not null ? null : L["customize.links.invalid"];
        _dirty = true;
    }

    private void SetLinkTitle(int index, string value)
    {
        _links[index].Title = value;
        _dirty = true;
    }

    /// <summary>The links as they would be saved: normalized, empty rows left out.</summary>
    private List<ProfileLinkDto> CleanLinks() => _links
        .Select(l => (Url: ProfileStyle.NormalizeLinkUrl(l.Url), Title: ProfileStyle.NormalizeLinkTitle(l.Title)))
        .Where(l => l.Url is not null)
        .Select(l => new ProfileLinkDto { Url = l.Url!, Title = l.Title })
        .ToList();

    private bool LinksChanged(MeDto me) => !CleanLinks().SequenceEqual(me.Links);

    // ---- Look: color and cover (saved at once) ----

    private async Task SetColorAsync(string? key)
    {
        if (Auth.Me is not { } me || me.ProfileColor == key || _lookBusy) return;
        _lookBusy = true;
        try
        {
            Auth.UpdateMe(await Api.UpdateProfileAsync(new UpdateProfileRequest { ProfileColor = key ?? "" }));
        }
        catch (Exception ex)
        {
            Toasts.Error(ex);
        }
        finally
        {
            _lookBusy = false;
        }
    }

    private async Task SetCoverAsync(string? gradient)
    {
        if (Auth.Me is not { } me || _lookBusy) return;
        if (gradient is null ? me.Cover is null : me.Cover?.Gradient == gradient) return;
        _lookBusy = true;
        try
        {
            var updated = gradient is null
                ? await Api.RemoveCoverAsync()
                : await Api.SetCoverAsync(new SetCoverRequest { Gradient = gradient });
            Auth.UpdateMe(updated);
        }
        catch (Exception ex)
        {
            Toasts.Error(ex);
        }
        finally
        {
            _lookBusy = false;
        }
    }

    private async Task PickCoverPhotoAsync()
    {
        if (_coverBusy) return;
        PickedPhoto? photo;
        try
        {
            photo = await Avatars.PickAsync();
        }
        catch (Exception ex)
        {
            Toasts.Error(ex);
            return;
        }
        if (photo is null) return;
        _coverBusy = true;
        StateHasChanged();
        try
        {
            var media = await Avatars.UploadAsync(photo);
            Auth.UpdateMe(await Api.SetCoverAsync(new SetCoverRequest { MediaId = media.Id }));
            Toasts.Success(L["customize.cover.saved"]);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Toasts.Error(ex);
        }
        finally
        {
            _coverBusy = false;
        }
    }

    /// <summary>The cover band of the photo block (as others see it in my profile); null without color or cover.</summary>
    private string? CoverStyle(MeDto me)
    {
        if (me.Cover?.MediaId is { } photo) return $"background-image:url('{MediaUrls.ContentUrl(photo)}')";
        if (ProfileLook.CoverCss(me.Cover?.Gradient, Theme.IsDark) is { } sky) return $"background:{sky}";
        return ProfileLook.Accent(me.ProfileColor) is null ? null : "";
    }

    private string? CoverTileStyle(MeDto me) =>
        me.Cover?.MediaId is { } photo ? $"background-image:url('{MediaUrls.ThumbnailUrl(photo)}')" : null;

    // ---- Birthday ----

    private async Task EditBirthdayAsync() =>
        await Dialogs.ShowAsync<BirthdayDialog>(L["birthday.title"], null, new DialogOptions { Size = DialogSize.Small, Presentation = OverlayPresentation.Sheet });

    private string? BirthdayFooter(MeDto me) =>
        me.Birthday?.Year is null && me.Birthday is not null ? L["birthday.yearHint"] : null;

    private string LevelName(PrivacyLevel level) => L[$"settings.privacy.level.{level.ToString().ToLowerInvariant()}"];

    public ValueTask DisposeAsync()
    {
        _checkCts?.Cancel();
        _uploadCts?.Cancel();
        Dispose();
        return ValueTask.CompletedTask;
    }
}
