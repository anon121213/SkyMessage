@* DialogService content: pick a custom accent — our own picker, no system color dialog. Three wide, touch-friendly
   strips (ColorStrips: hue over a rainbow, vividness, lightness), a row of ready-made colors and the hex code. A small
   sky on top shows the result live: my bubble (as my bubble style paints it), the send orb and a button in the accent's
   gradient pair. Result: "#RRGGBB". *@
@inject ThemeService Theme
@inject ISettingsService Settings

<form class="accent-pick" @onsubmit="Save" @onsubmit:preventDefault="true">
    <div class="accent-pick__preview" aria-hidden="true">
        <div class="accent-pick__bubble" style="@($"background:{BubbleCss};color:{Bubble.Ink}")">
            @L["settings.appearance.preview.out"]
            <span class="accent-pick__meta" style="@($"color:{Bubble.Meta}")">09:42 <Icon Name="@IconNames.CheckCheck" Size="14" /></span>
        </div>
        <div class="accent-pick__row">
            <span class="accent-pick__button" style="@($"background:{GradientCss};color:{OnAccent}")">@L["common.ok"]</span>
            <span class="accent-pick__orb" style="@($"background:{GradientCss};color:{OnAccent}")"><Icon Name="@IconNames.ArrowUp" Size="22" StrokeWidth="2.6" /></span>
        </div>
    </div>

    <ColorStrips Hex="@CurrentHex" HexChanged="OnStrips" Label="@L["settings.appearance.customPick"]" />

    <div class="accent-pick__palette">
        <span class="accent-pick__label">@L["settings.appearance.customPalette"]</span>
        <div class="accent-pick__swatches">
            @foreach (var color in Theme.Catalog.AccentPalette)
            {
                var hex = color.Hex;
                <ColorSwatch @key="hex" Color="@($"linear-gradient(135deg, {hex} 0%, {Theme.Catalog.SecondHexOf(hex)} 100%)")" RingColor="@hex" Size="34" Label="@L[color.NameKey]"
                             Selected="@string.Equals(hex, CurrentHex, StringComparison.OrdinalIgnoreCase)" OnClick="() => PickPalette(hex)" />
            }
        </div>
    </div>

    <TextField Value="@_hex" ValueChanged="OnHexChanged" Label="@L["settings.appearance.customHex"]" Placeholder="#6A4BFF" MaxLength="7"
               Autocapitalize="off" Autocomplete="off" Spellcheck="false" Error="@_error">
        <Trailing><span class="accent-pick__chip" style="@($"background:{GradientCss}")" aria-hidden="true"></span></Trailing>
    </TextField>

    <DialogActions>
        <Button Variant="ButtonVariant.Ghost" OnClick="Dialog.Cancel">@L["common.cancel"]</Button>
        <Button Type="submit">@L["common.save"]</Button>
    </DialogActions>
</form>

@code {
    private string _hex = "";
    /// <summary>The last valid color: what the preview and the strips show while a typed code is incomplete.</summary>
    private string _valid = "#6A4BFF";
    private string? _error;

    [Inject] private ILocalizer L { get; set; } = default!;
    [CascadingParameter] public DialogReference Dialog { get; set; } = default!;

    [Parameter] public string Initial { get; set; } = "#6A4BFF";

    protected override void OnInitialized()
    {
        _hex = _valid = ThemeCatalog.NormalizeHex(Initial) ?? "#6A4BFF";
    }

    /// <summary>The color shown: the typed code when it is valid, else the last valid one.</summary>
    private string CurrentHex => ThemeCatalog.NormalizeHex(_hex) ?? _valid;

    private string SecondHex => Theme.Catalog.SecondHexOf(CurrentHex);

    private string GradientCss => $"linear-gradient(135deg, {CurrentHex} 0%, {SecondHex} 100%)";

    /// <summary>My bubble in this accent, painted as my bubble style does (my own colors ignore the accent: then the gradient).</summary>
    private BubblePaint Bubble =>
        Theme.Catalog.AccentBubble(CurrentHex, Settings.Current.Appearance.OutgoingBubble == OutgoingBubbleStyle.Solid ? OutgoingBubbleStyle.Solid : OutgoingBubbleStyle.Gradient, Theme.IsDark);

    private string BubbleCss => Bubble.Background;

    /// <summary>Text on the accent gradient: white unless the color is very light (as ThemeCatalog decides for --sm-on-accent).</summary>
    private string OnAccent => ThemeCatalog.OnAccentInk(ThemeCatalog.Color.Parse(CurrentHex), ThemeCatalog.Color.Parse(SecondHex)).Hex;

    private void OnStrips(string hex)
    {
        _hex = _valid = hex;
        _error = null;
    }

    private void PickPalette(string hex)
    {
        _hex = _valid = hex;
        _error = null;
    }

    private void OnHexChanged(string value)
    {
        _hex = value;
        _error = null;
        if (ThemeCatalog.NormalizeHex(value) is { } hex) _valid = hex;
    }

    private void Save()
    {
        if (ThemeCatalog.NormalizeHex(_hex) is not { } hex)
        {
            _error = L["settings.appearance.customInvalid"];
            return;
        }
        Dialog.Close(hex);
    }
}
