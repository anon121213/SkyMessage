@* Appearance: theme (three little flat scenes: dawn with a sun and a drifting cloud, night with a crescent and star
   dots, both split by a horizon line for "as the device"), accent (gradient pairs), message colors (my bubbles: the
   accent's gradient, flat, or my own colors; theirs: calm tints), the app's background (mini skies and "Свой": a
   gradient or a photo, BackdropEditor), the chats' background (as the app's, or their own), text size and bubble
   roundness, animations, compact list. A slice of a chat at the top shows the result live on the chats' background
   (colors ease over, a new background cross-fades in); sliders preview through ThemeService while dragging, with their
   own small sample right above them. Picks animate (the ring grows in, the check pops) only once the user changed
   something, not when the page opens. *@
@inherits UiComponentBase
@implements IAsyncDisposable
@inject ISettingsService Settings
@inject ThemeService Theme
@inject DialogService Dialogs
@inject BackdropPhotoService Photos
@inject BackdropPainter Painter

<SettingsScaffold Title="@L["settings.appearance.title"]">
    @{
        var a = Settings.Current.Appearance;
        var accentKey = ThemeCatalog.NormalizeHex(a.CustomAccentHex) is null ? a.Accent : null;
        var ownApp = a.CustomBackground;
        var ownAppSelected = string.Equals(a.Wallpaper, ThemeCatalog.CustomWallpaperKey, StringComparison.OrdinalIgnoreCase) && ownApp is not null;
        var ownChats = BackdropRules.Normalize(a.ChatBackground);
        // Chats that follow the app show its background as the root screens do (under its readability floor).
        var chatPaint = ownChats is null ? Painter.OnScreen(Theme.Catalog.ChatPaint(a, Theme.IsDark), Theme.IsDark) : Theme.Catalog.ChatPaint(a, Theme.IsDark);
        var chatPhoto = chatPaint.Photo is { } shownPhoto ? Painter.Url(shownPhoto, chatPaint.Blur) : null;
    }
    @* Paint servers and clips of the theme scenes (an always-rendered, zero-size svg). *@
    <svg class="look-defs" width="0" height="0" aria-hidden="true" focusable="false">
        <defs>
            <linearGradient id="look-day" x1="0" y1="0" x2="0.3" y2="1">
                <stop offset="0" stop-color="#C9BBFF" />
                <stop offset="0.55" stop-color="#F3DDF6" />
                <stop offset="1" stop-color="#FFE6D2" />
            </linearGradient>
            <linearGradient id="look-night" x1="0" y1="0" x2="0.3" y2="1">
                <stop offset="0" stop-color="#2B1F70" />
                <stop offset="0.6" stop-color="#17113D" />
                <stop offset="1" stop-color="#0C0920" />
            </linearGradient>
            <clipPath id="look-clip-day"><polygon points="0,0 120,0 0,90" /></clipPath>
            <clipPath id="look-clip-night"><polygon points="120,0 120,90 0,90" /></clipPath>
        </defs>
    </svg>

    <div class="look-preview" aria-hidden="true">
        <div class="look-preview__sky" style="@($"background:{chatPaint.Css};background-color:{chatPaint.Base}")"></div>
        @if (chatPhoto is not null)
        {
            <div class="look-preview__photo" style="@($"background-image:url(\"{chatPhoto}\")")"></div>
        }
        @if (chatPaint.Dim > 0)
        {
            <div class="look-preview__veil" style="@($"opacity:{Num(chatPaint.Dim)}")"></div>
        }
        @if (_fadeFrom is { } fade)
        {
            @* The previous background on top, fading out: a cross-fade to the new one. *@
            <div @key="_fadeKey" class="look-preview__fade" style="@($"background:{fade.Css};background-color:{fade.Base}")"></div>
        }
        <span class="look-preview__stars" style="@($"opacity:{Num(chatPaint.Stars)}")"></span>
        <div class="look-preview__head">
            <span class="look-preview__avatar">@Initial(L["settings.appearance.preview.name"])</span>
            <span class="look-preview__who">
                <span class="look-preview__name">@L["settings.appearance.preview.name"]</span>
                <span class="look-preview__status">@L["presence.online"]</span>
            </span>
        </div>
        <div class="look-preview__chat">
            <div class="look-bubble look-bubble--in">
                @L["settings.appearance.preview.in"]
                <span class="look-bubble__meta">09:41</span>
            </div>
            <div class="look-bubble look-bubble--out">
                @L["settings.appearance.preview.out"]
                <span class="look-bubble__meta">09:42 <Icon Name="@IconNames.CheckCheck" Size="14" /></span>
            </div>
        </div>
    </div>

    <Section Title="@L["settings.appearance.theme"]">
        <div class="look-modes @(_touched ? "is-live" : null)" role="radiogroup" aria-label="@L["settings.appearance.theme"]">
            @foreach (var mode in Modes)
            {
                var selected = mode.Value == a.Theme;
                <button @key="mode.Value" type="button" role="radio" aria-checked="@(selected ? "true" : "false")"
                        class="look-mode look-mode--@ModeClass(mode.Value) @(selected ? "is-selected" : null)" @onclick="() => PickThemeAsync(mode.Value)">
                    <span class="look-mode__art" aria-hidden="true">
                        @ModeScene(mode.Value)
                        @if (selected)
                        {
                            <span class="look-mode__check"><Icon Name="@IconNames.Check" Size="13" StrokeWidth="3" /></span>
                        }
                    </span>
                    <span class="look-mode__name">@mode.Label</span>
                </button>
            }
        </div>
    </Section>

    <Section Title="@L["settings.appearance.accent"]">
        <div class="look-accents @(_touched ? "is-live" : null)">
            <div class="look-accents__grid">
                @foreach (var accent in Theme.Accents)
                {
                    <ColorSwatch @key="accent.Key" Color="@accent.Gradient" RingColor="@accent.Hex" Label="@L[accent.NameKey]" Size="44"
                                 Selected="@(accent.Key == accentKey)" OnClick="() => PickAccentAsync(accent.Key)" />
                }
                <ColorSwatch Custom="true" Color="@(accentKey is null ? CustomGradient(a.CustomAccentHex) : null)" RingColor="@(accentKey is null ? ThemeCatalog.NormalizeHex(a.CustomAccentHex) : null)"
                             Size="44" Selected="@(accentKey is null)" Label="@L["theme.accent.custom"]" OnClick="PickCustomAccentAsync" />
            </div>
            <div class="look-accents__name">
                <span class="look-accents__dot" style="@($"background:{CurrentAccentGradient(a, accentKey)}")"></span>
                <span>@CurrentAccentName(accentKey)</span>
            </div>
        </div>
    </Section>

    <Section Title="@L["settings.appearance.messages"]">
        <div class="look-messages @(_touched ? "is-live" : null)">
            <span class="look-messages__label">@L["settings.appearance.outgoing"]</span>
            <div class="look-styles" role="radiogroup" aria-label="@L["settings.appearance.outgoing"]">
                @foreach (var style in OutgoingStyles)
                {
                    var selected = style.Value == a.OutgoingBubble;
                    var paint = StylePaint(a, style.Value);
                    <button @key="style.Value" type="button" role="radio" aria-checked="@(selected ? "true" : "false")"
                            class="look-style @(selected ? "is-selected" : null)" @onclick="() => PickOutgoingAsync(style.Value)">
                        <span class="look-style__tile" style="@($"background:{chatPaint.Css};background-color:{chatPaint.Base}")">
                            @if (paint is { } p)
                            {
                                @* Two of my bubbles, a long one and a short one: wide enough for a gradient to show as one. *@
                                <span class="look-style__bubble" style="@($"background:{p.Background};color:{p.Ink}")">@L["settings.appearance.outgoing.sample"]</span>
                                <span class="look-style__bubble look-style__bubble--short" style="@($"background:{p.Background};color:{p.Ink}")">@L["settings.appearance.outgoing.sample2"]</span>
                            }
                            else
                            {
                                <span class="look-style__bubble look-style__bubble--add"><Icon Name="@IconNames.Plus" Size="16" StrokeWidth="2.6" /></span>
                            }
                            @if (selected)
                            {
                                <span class="look-sky__check"><Icon Name="@IconNames.Check" Size="13" StrokeWidth="3" /></span>
                            }
                            @if (selected && style.Value == OutgoingBubbleStyle.Custom)
                            {
                                <span class="look-style__edit"><Icon Name="@IconNames.Pencil" Size="12" StrokeWidth="2.6" /></span>
                            }
                        </span>
                        <span class="look-style__name">@style.Label</span>
                    </button>
                }
            </div>

            <span class="look-messages__label">@L["settings.appearance.incoming"]</span>
            @* Their bubbles as they will look: small bubbles with a sample of their ink, on a strip of the chats' background. *@
            <div class="look-tints" role="radiogroup" aria-label="@L["settings.appearance.incoming"]"
                 style="@($"background:{chatPaint.Css};background-color:{chatPaint.Base}")">
                @foreach (var tint in Theme.Catalog.IncomingTints)
                {
                    var selected = string.Equals(tint.Key, a.IncomingTint, StringComparison.OrdinalIgnoreCase);
                    var tintPaint = Theme.Catalog.IncomingPaint(tint.Key, Theme.IsDark);
                    <button @key="tint.Key" type="button" role="radio" aria-checked="@(selected ? "true" : "false")" aria-label="@L[tint.NameKey]" title="@L[tint.NameKey]"
                            class="look-tint @(selected ? "is-selected" : null)" @onclick="() => PickTintAsync(tint.Key)">
                        <span class="look-tint__bubble" style="@($"background:{tintPaint.Background};color:{tintPaint.Ink}")" aria-hidden="true">@L["settings.appearance.tintSample"]</span>
                        @if (selected)
                        {
                            <span class="look-sky__check" aria-hidden="true"><Icon Name="@IconNames.Check" Size="13" StrokeWidth="3" /></span>
                        }
                    </button>
                }
            </div>
            <div class="look-accents__name">
                <span>@L[Theme.Catalog.FindTint(a.IncomingTint).NameKey]</span>
            </div>
        </div>
    </Section>

    <Section Title="@L["settings.appearance.wallpaper"]" Footer="@L["settings.appearance.wallpaperHint"]">
        <div class="look-skies @(_touched ? "is-live" : null)" role="radiogroup" aria-label="@L["settings.appearance.wallpaper"]">
            @foreach (var wallpaper in Theme.Wallpapers)
            {
                var selected = string.Equals(wallpaper.Key, a.Wallpaper, StringComparison.OrdinalIgnoreCase);
                var colors = Theme.IsDark ? wallpaper.Dark : wallpaper.Light;
                <button @key="wallpaper.Key" type="button" role="radio" aria-checked="@(selected ? "true" : "false")"
                        class="look-sky @(selected ? "is-selected" : null)" @onclick="() => PickWallpaperAsync(wallpaper.Key)">
                    <span class="look-sky__tile" aria-hidden="true">
                        <span class="look-sky__paint" style="@($"background:{colors.PreviewCss};background-color:{colors.Base}")">
                            @if (colors.Stars > 0)
                            {
                                <span class="look-sky__stars" style="@($"opacity:{Num(colors.Stars)}")"></span>
                            }
                            <span class="look-sky__bubble look-sky__bubble--in"></span>
                            <span class="look-sky__bubble look-sky__bubble--out"></span>
                        </span>
                        @if (selected)
                        {
                            <span class="look-sky__check"><Icon Name="@IconNames.Check" Size="13" StrokeWidth="3" /></span>
                        }
                    </span>
                    <span class="look-sky__name">@L[wallpaper.NameKey]</span>
                </button>
            }
            @OwnTile(ownApp is null ? null : Painter.OnScreen(Theme.Catalog.Paint(ownApp.For(Theme.IsDark), Theme.IsDark, screen: true), Theme.IsDark), ownAppSelected,
                     L["settings.background.own"], PickOwnAppAsync)
        </div>
    </Section>

    <Section Title="@L["settings.appearance.chatBackground"]" Footer="@L["settings.appearance.chatBackgroundHint"]">
        <div class="look-skies look-skies--chats @(_touched ? "is-live" : null)" role="radiogroup" aria-label="@L["settings.appearance.chatBackground"]">
            @{
                var followPaint = Painter.OnScreen(Theme.Catalog.AppPaint(a, Theme.IsDark), Theme.IsDark);
                var follows = ownChats is null;
            }
            <button type="button" role="radio" aria-checked="@(follows ? "true" : "false")" class="look-sky @(follows ? "is-selected" : null)" @onclick="FollowAppAsync">
                <span class="look-sky__tile" aria-hidden="true">
                    @SkyPaint(followPaint)
                    @if (follows)
                    {
                        <span class="look-sky__check"><Icon Name="@IconNames.Check" Size="13" StrokeWidth="3" /></span>
                    }
                </span>
                <span class="look-sky__name">@L["settings.background.followApp"]</span>
            </button>
            @OwnTile(ownChats is null ? null : Theme.Catalog.Paint(ownChats, Theme.IsDark), ownChats is not null, L["settings.background.own"], EditChatsAsync)
        </div>
    </Section>

    <Section Title="@L["settings.appearance.text"]">
        @* Sliders own horizontal drags: no swipe-back from inside them. The sample follows them live. *@
        <div class="look-text" data-no-swipe-back>
            <div class="look-text__sample" aria-hidden="true">
                <span class="look-mini look-mini--in">@L["settings.appearance.preview.in"]</span>
                <span class="look-mini look-mini--out">@L["settings.appearance.preview.out"]</span>
            </div>
            <Slider Value="_font" ValueChanged="PreviewFontAsync" OnChangeEnd="SaveFontAsync" Min="85" Max="140" Step="5" ShowValue="true"
                    Label="@L["settings.appearance.fontSize"]" Format="@(v => $"{v:0}%")" MinLabel="A" MaxLabel="A" Class="look-text__font" />
            <Slider Value="_radius" ValueChanged="PreviewRadiusAsync" OnChangeEnd="SaveRadiusAsync" Min="4" Max="24" Step="2" ShowValue="true"
                    Label="@L["settings.appearance.bubbleRadius"]" Format="@(v => $"{v:0}")" Class="look-text__radius" />
        </div>
    </Section>

    <Section DividerInset="64px">
        <SwitchItem Icon="@IconNames.CirclePlay" IconColor="@SettingsTones.Violet" Title="@L["settings.appearance.animations"]" Subtitle="@L["settings.appearance.animationsHint"]"
                    Checked="a.Animations" CheckedChanged="v => SaveAsync(s => s.Appearance.Animations = v)" />
        <SwitchItem Icon="@IconNames.List" IconColor="@SettingsTones.Sky" Title="@L["settings.appearance.compact"]" Subtitle="@L["settings.appearance.compactHint"]"
                    Checked="a.CompactChatList" CheckedChanged="v => SaveAsync(s => s.Appearance.CompactChatList = v)" />
    </Section>

    <Section>
        <ListItem Icon="@IconNames.RotateCcw" IconColor="@SettingsTones.Mauve" Title="@L["settings.appearance.reset"]" Multiline="true" OnClick="ResetAsync" />
    </Section>
</SettingsScaffold>

@code {
    private double _font;
    private double _radius;
    private bool _dragging;
    private bool _touched;
    private (string Css, string Base)? _fadeFrom;
    private int _fadeKey;
    private bool _editing;

    private IReadOnlyList<ChoiceOption<ThemeMode>> Modes =>
    [
        new(ThemeMode.System, L["theme.mode.system"]),
        new(ThemeMode.Light, L["theme.mode.light"]),
        new(ThemeMode.Dark, L["theme.mode.dark"]),
    ];

    private static string ModeClass(ThemeMode mode) => mode switch
    {
        ThemeMode.Light => "light",
        ThemeMode.Dark => "dark",
        _ => "system",
    };

    private IReadOnlyList<ChoiceOption<OutgoingBubbleStyle>> OutgoingStyles =>
    [
        new(OutgoingBubbleStyle.Gradient, L["settings.appearance.outgoing.gradient"]),
        new(OutgoingBubbleStyle.Solid, L["settings.appearance.outgoing.solid"]),
        new(OutgoingBubbleStyle.Custom, L["settings.appearance.outgoing.custom"]),
    ];

    private static string Num(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>My bubble as a style paints it (my own colors: null until there are some).</summary>
    private BubblePaint? StylePaint(AppearanceSettings a, OutgoingBubbleStyle style) => style switch
    {
        OutgoingBubbleStyle.Custom => a.OutgoingColors.Count > 0 ? Theme.Catalog.CustomBubble(a.OutgoingColors, Theme.IsDark) : null,
        _ => Theme.Catalog.AccentBubble(Theme.AccentHex, style, Theme.IsDark),
    };

    /// <summary>A mini background in a tile: its colors, its photo under the veil, star dots, two tiny bubbles.</summary>
    private RenderFragment SkyPaint(BackdropPaint paint) => __builder =>
    {
        var url = paint.Photo is { } photo ? Painter.Url(photo, paint.Blur) : null;
        <span class="look-sky__paint" style="@($"background:{paint.Css};background-color:{paint.Base}")">
            @if (url is not null)
            {
                <span class="look-sky__photo" style="@($"background-image:url(\"{url}\")")"></span>
            }
            @if (paint.Dim > 0)
            {
                <span class="look-sky__veil" style="@($"opacity:{Num(paint.Dim)}")"></span>
            }
            @if (paint.Stars > 0)
            {
                <span class="look-sky__stars" style="@($"opacity:{Num(paint.Stars)}")"></span>
            }
            <span class="look-sky__bubble look-sky__bubble--in"></span>
            <span class="look-sky__bubble look-sky__bubble--out"></span>
        </span>
    };

    /// <summary>"Свой": the own background (or a plus before there is one), a pencil once it is chosen (tap again to edit).</summary>
    private RenderFragment OwnTile(BackdropPaint? paint, bool selected, string label, Func<Task> onClick) => __builder =>
    {
        <button type="button" role="radio" aria-checked="@(selected ? "true" : "false")" class="look-sky look-sky--own @(selected ? "is-selected" : null)"
                title="@(selected ? L["settings.background.edit"] : label)" @onclick="onClick">
            <span class="look-sky__tile" aria-hidden="true">
                @if (paint is not null)
                {
                    @SkyPaint(paint)
                }
                else
                {
                    <span class="look-sky__paint look-sky__paint--add"><Icon Name="@IconNames.Plus" Size="20" StrokeWidth="2.4" /></span>
                }
                @if (selected)
                {
                    <span class="look-sky__check"><Icon Name="@IconNames.Check" Size="13" StrokeWidth="3" /></span>
                    <span class="look-sky__edit"><Icon Name="@IconNames.Pencil" Size="12" StrokeWidth="2.6" /></span>
                }
            </span>
            <span class="look-sky__name">@label</span>
        </button>
    };

    private static string Initial(string name) => string.IsNullOrEmpty(name) ? "" : name[..1];

    private string CustomGradient(string? hex) => ThemeCatalog.NormalizeHex(hex) is { } h
        ? $"linear-gradient(135deg, {h} 0%, {Theme.Catalog.SecondHexOf(h)} 100%)"
        : "";

    private string CurrentAccentGradient(AppearanceSettings a, string? accentKey) =>
        accentKey is null ? CustomGradient(a.CustomAccentHex) : (Theme.Catalog.FindAccent(accentKey) ?? Theme.Catalog.DefaultAccent).Gradient;

    private string CurrentAccentName(string? accentKey) =>
        accentKey is null ? L["theme.accent.custom"] : L[(Theme.Catalog.FindAccent(accentKey) ?? Theme.Catalog.DefaultAccent).NameKey];

    /// <summary>A tiny flat sky for each theme mode: dawn with a sun and a cloud, night with a crescent and a few star dots,
    /// or both split by a thin horizon line.</summary>
    private RenderFragment ModeScene(ThemeMode mode) => __builder =>
    {
        var both = mode == ThemeMode.System;
        <svg class="look-mode__scene" viewBox="0 0 120 90" preserveAspectRatio="xMidYMid slice" focusable="false">
            @if (mode != ThemeMode.Dark)
            {
                <g clip-path="@(both ? "url(#look-clip-day)" : null)">
                    <rect width="120" height="90" fill="url(#look-day)" />
                    <circle class="look-mode__sun" cx="@(both ? 32 : 82)" cy="@(both ? 26 : 30)" r="11" />
                    <g class="look-mode__cloud">
                        <circle cx="@(both ? 22 : 36)" cy="62" r="9" />
                        <circle cx="@(both ? 33 : 47)" cy="57" r="12" />
                        <circle cx="@(both ? 44 : 58)" cy="63" r="8" />
                        <rect x="@(both ? 13 : 27)" y="61" width="40" height="11" rx="5.5" />
                    </g>
                </g>
            }
            @if (mode != ThemeMode.Light)
            {
                <g clip-path="@(both ? "url(#look-clip-night)" : null)">
                    <rect width="120" height="90" fill="url(#look-night)" />
                    <circle class="look-mode__star" cx="@(both ? 70 : 24)" cy="@(both ? 70 : 22)" r="1.3" />
                    <circle class="look-mode__star look-mode__star--2" cx="@(both ? 98 : 42)" cy="@(both ? 80 : 54)" r="1" />
                    <circle class="look-mode__star look-mode__star--3" cx="@(both ? 108 : 100)" cy="@(both ? 44 : 66)" r="1.2" />
                    <circle class="look-mode__star look-mode__star--2" cx="@(both ? 62 : 18)" cy="@(both ? 84 : 72)" r="0.9" />
                    <path class="look-mode__moon" d="@MoonPath(both ? 88 : 78, both ? 60 : 36)" />
                </g>
            }
            @if (both)
            {
                <line class="look-mode__horizon" x1="120" y1="0" x2="0" y2="90" />
            }
        </svg>
    };

    /// <summary>A crescent of radius 11 around (cx, cy).</summary>
    private static string MoonPath(double cx, double cy) =>
        $"M{Num(cx + 3)} {Num(cy - 11)}a11 11 0 1 0 8 19.5A9 9 0 0 1 {Num(cx + 3)} {Num(cy - 11)}Z";

    protected override void OnInitialized()
    {
        ReadSliders();
        Settings.Changed += OnSettingsChanged;
        OnDispose(() => Settings.Changed -= OnSettingsChanged);
        RenderOn(h => Theme.Changed += h, h => Theme.Changed -= h);
        RenderOn(h => Painter.Changed += h, h => Painter.Changed -= h);
    }

    private void OnSettingsChanged() => _ = InvokeAsync(() =>
    {
        if (!_dragging) ReadSliders();
        StateHasChanged();
    });

    private void ReadSliders()
    {
        var a = Settings.Current.Appearance;
        _font = Math.Clamp(a.FontScalePercent, 85, 140);
        _radius = Math.Clamp(a.BubbleRadius, 4, 24);
    }

    private Task SaveAsync(Action<AppSettings> change) => Settings.UpdateAsync(change);

    private Task PickThemeAsync(ThemeMode mode)
    {
        if (mode == Settings.Current.Appearance.Theme) return Task.CompletedTask;
        _touched = true;
        return SaveAsync(s => s.Appearance.Theme = mode);
    }

    private Task PickAccentAsync(string key)
    {
        _touched = true;
        return SaveAsync(s =>
        {
            s.Appearance.Accent = key;
            s.Appearance.CustomAccentHex = null;
        });
    }

    private async Task PickWallpaperAsync(string key)
    {
        var current = Settings.Current.Appearance.Wallpaper;
        if (string.Equals(current, key, StringComparison.OrdinalIgnoreCase)) return;
        _touched = true;
        await FadeAsync();
        await SaveAsync(s => s.Appearance.Wallpaper = key);
    }

    /// <summary>
    /// Paints the preview's current background on top first: once the change lands, the new one shows through as that
    /// layer fades (a picture fades as its plain base).
    /// </summary>
    private async Task FadeAsync()
    {
        var paint = Theme.Catalog.ChatPaint(Settings.Current.Appearance, Theme.IsDark);
        _fadeFrom = (paint.Css, paint.Base);
        _fadeKey++;
        StateHasChanged();
        await Task.Yield();
    }

    private Task PickOutgoingAsync(OutgoingBubbleStyle style)
    {
        var a = Settings.Current.Appearance;
        if (style == OutgoingBubbleStyle.Custom && (a.OutgoingColors.Count == 0 || a.OutgoingBubble == OutgoingBubbleStyle.Custom))
            return EditOutgoingColorsAsync();
        if (style == a.OutgoingBubble) return Task.CompletedTask;
        _touched = true;
        return SaveAsync(s => s.Appearance.OutgoingBubble = style);
    }

    private async Task EditOutgoingColorsAsync()
    {
        if (_editing) return;
        _editing = true;
        try
        {
            var result = await Dialogs.ShowAsync<BubbleColorsDialog>(L["settings.appearance.bubbleColorsTitle"], new Dictionary<string, object?>
            {
                [nameof(BubbleColorsDialog.Initial)] = Settings.Current.Appearance.OutgoingColors.ToList(),
            }, new DialogOptions { Presentation = OverlayPresentation.Auto });
            if (result is List<string> { Count: > 0 } colors)
            {
                _touched = true;
                await SaveAsync(s =>
                {
                    s.Appearance.OutgoingColors = colors;
                    s.Appearance.OutgoingBubble = OutgoingBubbleStyle.Custom;
                });
            }
        }
        finally
        {
            _editing = false;
        }
    }

    private Task PickTintAsync(string key)
    {
        if (string.Equals(key, Settings.Current.Appearance.IncomingTint, StringComparison.OrdinalIgnoreCase)) return Task.CompletedTask;
        _touched = true;
        return SaveAsync(s => s.Appearance.IncomingTint = key);
    }

    /// <summary>"Свой" among the skies: picks the own background kept from before, or (chosen, or none yet) edits it.</summary>
    private async Task PickOwnAppAsync()
    {
        var a = Settings.Current.Appearance;
        var chosen = string.Equals(a.Wallpaper, ThemeCatalog.CustomWallpaperKey, StringComparison.OrdinalIgnoreCase);
        if (a.CustomBackground is not null && !chosen)
        {
            _touched = true;
            await FadeAsync();
            await SaveAsync(s => s.Appearance.Wallpaper = ThemeCatalog.CustomWallpaperKey);
            return;
        }
        var result = await EditAsync(BackdropTarget.App, L["settings.background.appTitle"], a.CustomBackground, null);
        if (result?.App is { } app)
        {
            _touched = true;
            await FadeAsync();
            await Photos.SetAppBackgroundAsync(app);
        }
    }

    private async Task FollowAppAsync()
    {
        if (Settings.Current.Appearance.ChatBackground is null) return;
        _touched = true;
        await FadeAsync();
        await Photos.SetChatDefaultAsync(null);
    }

    private async Task EditChatsAsync()
    {
        var result = await EditAsync(BackdropTarget.ChatDefault, L["settings.background.chatsTitle"], null, Settings.Current.Appearance.ChatBackground);
        if (result is null) return;
        _touched = true;
        await FadeAsync();
        await Photos.SetChatDefaultAsync(result.Reset ? null : result.Backdrop);
    }

    private async Task<BackdropEditorResult?> EditAsync(BackdropTarget target, string title, AppBackground? app, Backdrop? backdrop)
    {
        if (_editing) return null;
        _editing = true;
        try
        {
            return await Dialogs.ShowAsync<BackdropEditor>(title, new Dictionary<string, object?>
            {
                [nameof(BackdropEditor.Target)] = target,
                [nameof(BackdropEditor.App)] = app?.Clone(),
                [nameof(BackdropEditor.Initial)] = backdrop?.Clone(),
            }, new DialogOptions { Size = DialogSize.Medium, Presentation = OverlayPresentation.Auto }) as BackdropEditorResult;
        }
        finally
        {
            _editing = false;
        }
    }

    private Task PreviewFontAsync(double value)
    {
        _dragging = true;
        _font = value;
        return PreviewAsync();
    }

    private Task PreviewRadiusAsync(double value)
    {
        _dragging = true;
        _radius = value;
        return PreviewAsync();
    }

    private Task PreviewAsync()
    {
        var copy = Settings.Current.Clone().Appearance;
        copy.FontScalePercent = (int)Math.Round(_font);
        copy.BubbleRadius = (int)Math.Round(_radius);
        return Theme.PreviewAsync(copy);
    }

    private async Task SaveFontAsync(double value)
    {
        _font = value;
        await Settings.UpdateAsync(s => s.Appearance.FontScalePercent = (int)Math.Round(value));
        await EndDragAsync();
    }

    private async Task SaveRadiusAsync(double value)
    {
        _radius = value;
        await Settings.UpdateAsync(s => s.Appearance.BubbleRadius = (int)Math.Round(value));
        await EndDragAsync();
    }

    private async Task EndDragAsync()
    {
        _dragging = false;
        await Theme.EndPreviewAsync();
    }

    private async Task PickCustomAccentAsync()
    {
        var current = ThemeCatalog.NormalizeHex(Settings.Current.Appearance.CustomAccentHex) ?? Theme.AccentHex;
        var result = await Dialogs.ShowAsync<CustomAccentDialog>(L["settings.appearance.customTitle"], new Dictionary<string, object?>
        {
            [nameof(CustomAccentDialog.Initial)] = current,
        }, new DialogOptions { Presentation = OverlayPresentation.Auto });
        if (result is string hex && ThemeCatalog.NormalizeHex(hex) is { } normalized)
        {
            _touched = true;
            await Settings.UpdateAsync(s => s.Appearance.CustomAccentHex = normalized);
        }
    }

    private async Task ResetAsync()
    {
        if (!await Dialogs.ConfirmAsync(L["settings.appearance.resetTitle"], L["settings.appearance.resetText"], L["settings.appearance.resetConfirm"])) return;
        // Single chats keep their own backgrounds (they were set in those chats, not here).
        await Settings.UpdateAsync(s => s.Appearance = new AppearanceSettings { ChatBackgrounds = s.Appearance.ChatBackgrounds });
        ReadSliders();
    }

    public async ValueTask DisposeAsync()
    {
        if (Theme.IsPreviewing) await Theme.EndPreviewAsync();
        Dispose();
    }
}
