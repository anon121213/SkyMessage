@* DialogService content: change my password (current + new twice), optionally signing out other devices. *@
@inject ISkyApi Api
@inject ToastService Toasts

<form class="sm-col sm-gap-m" @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
    <TextField @bind-Value="_current" Label="@L["settings.password.current"]" Type="password" Autocomplete="current-password" Autofocus="true" Error="@_currentError" />
    <TextField @bind-Value="_new" Label="@L["settings.password.new"]" Type="password" Autocomplete="new-password" MaxLength="Limits.PasswordMaxLength"
               Hint="@L.Format("settings.password.rule", Limits.PasswordMinLength)" Error="@_newError" />
    <TextField @bind-Value="_repeat" Label="@L["settings.password.repeat"]" Type="password" Autocomplete="new-password" MaxLength="Limits.PasswordMaxLength"
               Error="@_repeatError" />
    <Checkbox @bind-Checked="_signOutOthers" Label="@L["settings.password.signOutOthers"]" />
    <DialogActions>
        <Button Variant="ButtonVariant.Ghost" OnClick="Dialog.Cancel">@L["common.cancel"]</Button>
        <Button Type="submit" Loading="_saving">@L["settings.password.save"]</Button>
    </DialogActions>
</form>

@code {
    private string _current = "";
    private string _new = "";
    private string _repeat = "";
    private bool _signOutOthers = true;
    private bool _saving;
    private string? _currentError;
    private string? _newError;
    private string? _repeatError;

    [Inject] private ILocalizer L { get; set; } = default!;
    [CascadingParameter] public DialogReference Dialog { get; set; } = default!;

    private async Task SaveAsync()
    {
        _currentError = string.IsNullOrEmpty(_current) ? L["settings.password.currentRequired"] : null;
        _newError = _new.Length < Limits.PasswordMinLength ? L.Format("settings.password.rule", Limits.PasswordMinLength) : null;
        _repeatError = _newError is null && _repeat != _new ? L["settings.password.mismatch"] : null;
        if (_currentError is not null || _newError is not null || _repeatError is not null) return;

        _saving = true;
        try
        {
            await Api.ChangePasswordAsync(new ChangePasswordRequest
            {
                CurrentPassword = _current,
                NewPassword = _new,
                TerminateOtherSessions = _signOutOthers,
            });
            Toasts.Success(L["settings.password.changed"]);
            Dialog.Close(true);
        }
        catch (ApiException ex) when (ex.Code == ErrorCodes.WrongPassword)
        {
            _currentError = L.Error(ex);
        }
        catch (ApiException ex) when (ex.Code == ErrorCodes.PasswordTooWeak)
        {
            _newError = L.Error(ex);
        }
        catch (Exception ex)
        {
            Toasts.Error(ex);
        }
        finally
        {
            _saving = false;
        }
    }
}
