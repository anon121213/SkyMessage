@* Notifications & sounds: system permission, message/call toggles, the sound pack (wood, bells, piano), tone pickers
   with previews and the user's own message tone and ringtone, in-app sounds, and (Android) keeping the connection
   alive in background + the battery exemption. iPhones and browsers get a hint about when messages and calls can
   arrive until push notifications exist. *@
@inherits UiComponentBase
@inject ISettingsService Settings
@inject ISoundService Sounds
@inject IPermissionService Permissions
@inject ILocalNotificationService Notifications
@inject IBackgroundConnectionService Background
@inject IPlatformInfo Platform
@inject ToastService Toasts
@inject DialogService Dialogs
@inject CustomSoundService CustomSounds

<SettingsScaffold Title="@L["settings.notifications.title"]">
    @{
        var n = Settings.Current.Notifications;
    }
    @if (_permission is PermissionState.Denied or PermissionState.Restricted)
    {
        <div class="notif-alert sm-card">
            <span class="sm-list-item__icon notif-alert__tile" style="--icon-bg:@SettingsTones.Rose"><Icon Name="@IconNames.BellOff" /></span>
            <div class="notif-alert__text">
                <div class="sm-strong">@L["settings.notifications.blocked"]</div>
                <div class="sm-caption">@(Platform.IsNativeApp ? L["settings.notifications.blockedText"] : L["settings.notifications.blockedTextWeb"])</div>
            </div>
            @if (Platform.IsNativeApp)
            {
                <Button Size="ButtonSize.Small" Variant="ButtonVariant.Tonal" OnClick="Permissions.OpenAppSettingsAsync">@L["settings.openSystemSettings"]</Button>
            }
        </div>
    }
    else if (_permission is PermissionState.Unknown && n.Enabled)
    {
        <div class="notif-alert sm-card">
            <span class="sm-list-item__icon notif-alert__tile notif-alert__tile--ring" style="--icon-bg:@SettingsTones.Gold"><Icon Name="@IconNames.BellRing" /></span>
            <div class="notif-alert__text">
                <div class="sm-strong">@L["settings.notifications.ask"]</div>
                <div class="sm-caption">@L["settings.notifications.askText"]</div>
            </div>
            <Button Size="ButtonSize.Small" OnClick="RequestPermissionAsync">@L["settings.notifications.allow"]</Button>
        </div>
    }

    @if (Platform.Platform == ClientPlatform.iOS)
    {
        <div class="notif-hint sm-card">
            <Icon Name="@IconNames.Info" Size="20" />
            <span>@L["settings.notifications.iosHint"]</span>
        </div>
    }
    else if (!Platform.IsNativeApp)
    {
        <div class="notif-hint sm-card">
            <Icon Name="@IconNames.Info" Size="20" />
            <span>@L["settings.notifications.webHint"]</span>
        </div>
    }

    <Section Title="@L["settings.notifications.messages"]" DividerInset="64px">
        <SwitchItem Icon="@IconNames.Bell" IconColor="@SettingsTones.Rose" Title="@L["settings.notifications.enabled"]" Subtitle="@L["settings.notifications.enabledHint"]"
                    Checked="n.Enabled" CheckedChanged="v => SetAsync(s => s.Notifications.Enabled = v, requestPermission: v)" />
        <SwitchItem Icon="@IconNames.Eye" IconColor="@SettingsTones.Violet" Title="@L["settings.notifications.preview"]" Subtitle="@L["settings.notifications.previewHint"]"
                    Checked="n.ShowPreview" Disabled="!n.Enabled" CheckedChanged="v => SetAsync(s => s.Notifications.ShowPreview = v)" />
        <SwitchItem Icon="@IconNames.Users" IconColor="@SettingsTones.Peach" Title="@L["settings.notifications.groups"]" Checked="n.GroupsEnabled" Disabled="!n.Enabled"
                    CheckedChanged="v => SetAsync(s => s.Notifications.GroupsEnabled = v)" />
        <SwitchItem Icon="@IconNames.AtSign" IconColor="@SettingsTones.Sky" Title="@L["settings.notifications.mentions"]" Subtitle="@L["settings.notifications.mentionsHint"]"
                    Checked="n.MentionsBypassMute" Disabled="!n.Enabled" CheckedChanged="v => SetAsync(s => s.Notifications.MentionsBypassMute = v)" />
        <SwitchItem Icon="@IconNames.Volume2" IconColor="@SettingsTones.Mint" Title="@L["settings.notifications.sound"]" Checked="n.Sound" Disabled="!n.Enabled"
                    CheckedChanged="v => SetAsync(s => s.Notifications.Sound = v)" />
        @if (Platform.IsMobile)
        {
            <SwitchItem Icon="@IconNames.Vibrate" IconColor="@SettingsTones.Lagoon" Title="@L["settings.notifications.vibrate"]" Checked="n.Vibrate" Disabled="!n.Enabled"
                        CheckedChanged="v => SetAsync(s => s.Notifications.Vibrate = v)" />
        }
    </Section>

    <Section Title="@L["settings.notifications.pack"]" Footer="@L["settings.notifications.packHint"]">
        <SoundPackPicker Value="@n.SoundPack" ValueChanged="SetPackAsync" Label="@L["settings.notifications.pack"]" />
    </Section>

    <Section Title="@L["settings.notifications.messageTone"]" Footer="@ToneFooter(n.CustomMessageTone)">
        <TonePicker Options="MessageTones" Value="@n.MessageTone" ValueChanged="SetMessageToneAsync" CustomSupported="CustomSounds.IsSupported"
                    Custom="n.CustomMessageTone" PickHint="@L["settings.notifications.customPickHint.message"]" Busy="@(_importing == CustomSoundSlot.Message)"
                    OnImport="() => ImportAsync(CustomSoundSlot.Message)" OnRemove="() => RemoveAsync(CustomSoundSlot.Message)" />
    </Section>

    <Section Title="@L["settings.notifications.calls"]" DividerInset="64px">
        <SwitchItem Icon="@IconNames.PhoneIncoming" IconColor="@SettingsTones.Mint" Title="@L["settings.notifications.callsEnabled"]" Subtitle="@L["settings.notifications.callsHint"]"
                    Checked="n.CallsEnabled" CheckedChanged="v => SetAsync(s => s.Notifications.CallsEnabled = v, requestPermission: v)" />
    </Section>

    <Section Title="@L["settings.notifications.ringtone"]" Footer="@(n.CustomRingtone is null ? null : ToneFooter(n.CustomRingtone))">
        <TonePicker Options="Ringtones" Value="@n.Ringtone" ValueChanged="SetRingtoneAsync" CustomSupported="CustomSounds.IsSupported"
                    Custom="n.CustomRingtone" PickHint="@L["settings.notifications.customPickHint.ringtone"]" Busy="@(_importing == CustomSoundSlot.Ringtone)"
                    OnImport="() => ImportAsync(CustomSoundSlot.Ringtone)" OnRemove="() => RemoveAsync(CustomSoundSlot.Ringtone)" />
    </Section>

    <Section Title="@L["settings.notifications.inApp"]" DividerInset="64px">
        <SwitchItem Icon="@IconNames.Music" IconColor="@SettingsTones.Orchid" Title="@L["settings.notifications.inAppSounds"]" Checked="n.InAppSounds"
                    CheckedChanged="v => SetAsync(s => s.Notifications.InAppSounds = v)" />
        @if (Platform.IsMobile)
        {
            <SwitchItem Icon="@IconNames.Vibrate" IconColor="@SettingsTones.Lagoon" Title="@L["settings.notifications.inAppVibrate"]" Checked="n.InAppVibrate"
                        CheckedChanged="v => SetAsync(s => s.Notifications.InAppVibrate = v)" />
        }
    </Section>

    @if (Background.IsSupported)
    {
        <Section Title="@L["settings.notifications.background"]" Footer="@L["settings.notifications.backgroundHint"]" DividerInset="64px">
            <SwitchItem Icon="@IconNames.PlugZap" IconColor="@SettingsTones.Violet" Title="@L["settings.notifications.keepConnected"]" Subtitle="@L["settings.notifications.keepConnectedHint"]"
                        Checked="n.KeepConnectedInBackground" CheckedChanged="SetKeepConnectedAsync" />
            <ListItem Icon="@IconNames.BatteryCharging" IconColor="@SettingsTones.Mint" Title="@L["settings.notifications.battery"]" Subtitle="@L["settings.notifications.batteryHint"]"
                      Multiline="true" Disabled="@(!n.KeepConnectedInBackground)" OnClick="RequestBatteryExemptionAsync" Chevron="true" />
        </Section>
    }
</SettingsScaffold>

@code {
    private PermissionState? _permission;
    private CustomSoundSlot? _importing;

    private IReadOnlyList<ChoiceOption<string>> MessageTones =>
        Sounds.Tones.MessageTones.Select(t => new ChoiceOption<string>(t.Key, L[t.NameKey]))
            .Append(new ChoiceOption<string>(ToneCatalog.None, L["sound.tone.none"]))
            .ToList();

    private IReadOnlyList<ChoiceOption<string>> Ringtones =>
        Sounds.Tones.Ringtones.Select(t => new ChoiceOption<string>(t.Key, L[t.NameKey])).ToList();

    protected override async Task OnInitializedAsync()
    {
        RenderOn(h => Settings.Changed += h, h => Settings.Changed -= h);
        // A preview (an own ringtone runs up to 12 s) ends with the page; a ringing call does not.
        OnDispose(Sounds.StopPreview);
        await CheckPermissionAsync();
    }

    private async Task CheckPermissionAsync()
    {
        try
        {
            _permission = await Permissions.CheckAsync(AppPermission.Notifications);
        }
        catch (Exception)
        {
            _permission = PermissionState.NotApplicable;
        }
    }

    private async Task SetAsync(Action<AppSettings> change, bool requestPermission = false)
    {
        await Settings.UpdateAsync(change);
        if (requestPermission && _permission is PermissionState.Unknown) await RequestPermissionAsync();
    }

    private async Task RequestPermissionAsync()
    {
        try
        {
            var granted = await Notifications.RequestPermissionAsync();
            await CheckPermissionAsync();
            if (!granted && _permission is not (PermissionState.Denied or PermissionState.Restricted)) _permission = PermissionState.Denied;
        }
        catch (Exception ex)
        {
            Toasts.Error(ex);
        }
    }

    private Task SetPackAsync(string pack) => Settings.UpdateAsync(s => s.Notifications.SoundPack = pack);

    private async Task SetMessageToneAsync(string key)
    {
        if (key == ToneCatalog.Custom) Sounds.PreviewCustom(CustomSoundSlot.Message);
        else Sounds.Preview(key);
        await Settings.UpdateAsync(s => s.Notifications.MessageTone = key);
    }

    private async Task SetRingtoneAsync(string key)
    {
        if (key == ToneCatalog.Custom) Sounds.PreviewCustom(CustomSoundSlot.Ringtone);
        else Sounds.Preview(key);
        await Settings.UpdateAsync(s => s.Notifications.Ringtone = key);
    }

    // Under the tones: "tap to listen" and, once there is an own sound, where it lives (and, on Apple devices, that
    // system notifications keep the pack's sound).
    private string ToneFooter(CustomSound? custom)
    {
        var text = L["settings.notifications.toneHint"];
        if (custom is null) return text;
        text += " " + L["settings.notifications.customHint"];
        return Platform.Platform is ClientPlatform.iOS or ClientPlatform.MacOS && Platform.IsNativeApp
            ? text + " " + L["settings.notifications.customAppleHint"]
            : text;
    }

    private async Task ImportAsync(CustomSoundSlot slot)
    {
        if (_importing is not null) return;
        _importing = slot;
        try
        {
            var problem = await CustomSounds.ImportAsync(slot);
            if (problem == CustomSoundProblem.None) Sounds.PreviewCustom(slot);
            else if (problem is { } refused) Toasts.Warning(ProblemText(slot, refused));
        }
        catch (Exception ex)
        {
            Toasts.Error(ex);
        }
        finally
        {
            _importing = null;
            RequestRender();
        }
    }

    private async Task RemoveAsync(CustomSoundSlot slot)
    {
        var pack = Sounds.Tones.FindPack(Settings.Current.Notifications.SoundPack) ?? Sounds.Tones.Packs[0];
        var confirmed = await Dialogs.ConfirmAsync(L["settings.notifications.customRemoveTitle"],
            L.Format("settings.notifications.customRemoveText", L[pack.NameKey]), L["common.delete"], danger: true);
        if (!confirmed) return;
        try
        {
            await CustomSounds.ResetAsync(slot);
        }
        catch (Exception ex)
        {
            Toasts.Error(ex);
        }
    }

    private string ProblemText(CustomSoundSlot slot, CustomSoundProblem problem) => problem switch
    {
        CustomSoundProblem.Format => L["settings.notifications.customError.format"],
        CustomSoundProblem.Empty => L["settings.notifications.customError.empty"],
        CustomSoundProblem.TooLarge => L.Format("settings.notifications.customError.tooLarge", CustomSoundRules.MaxBytes / (1024 * 1024)),
        CustomSoundProblem.TooShort => L["settings.notifications.customError.tooShort"],
        CustomSoundProblem.SystemCannotPlay => L["settings.notifications.customError.system"],
        CustomSoundProblem.TooLong => slot == CustomSoundSlot.Message
            ? L["settings.notifications.customError.tooLongMessage"]
            : L["settings.notifications.customError.tooLongRingtone"],
        _ => L["settings.notifications.customError.unreadable"],
    };

    private async Task SetKeepConnectedAsync(bool enabled)
    {
        // The bootstrapper starts/stops the background service when this setting changes.
        await Settings.UpdateAsync(s => s.Notifications.KeepConnectedInBackground = enabled);
        if (enabled) await RequestBatteryExemptionAsync();
    }

    private async Task RequestBatteryExemptionAsync()
    {
        try
        {
            if (await Background.RequestBatteryExemptionAsync()) Toasts.Success(L["settings.notifications.batteryDone"]);
        }
        catch (Exception ex)
        {
            Toasts.Error(ex);
        }
    }
}
