@* DialogService content: pick chats for a folder (its included or excluded chats). Saved Messages first, then the chat
   list and the archive; a search capsule on top; squircle gradient checks. Closes with the chosen chat ids
   (IReadOnlyList<Guid>, possibly empty) or null when cancelled. *@
@inherits UiComponentBase
@inject IChatListStore ChatList
@inject LayoutService Layout
@inject ILogger<ChatPickerDialog> Logger

<div class="chat-pick">
    <div class="chat-pick__search">
        <SearchBox Value="@_query" ValueChanged="v => _query = v ?? string.Empty" DebounceMs="0" Autofocus="@(!Layout.IsTouch)" Placeholder="@L["folders.picker.search"]" />
    </div>
    <div class="chat-pick__list">
        @{
            var chats = Filtered;
        }
        @if (chats.Count == 0)
        {
            <EmptyState Icon="@IconNames.SearchX" Title="@L["folders.picker.nothing"]" />
        }
        @foreach (var chat in chats)
        {
            var item = chat;
            var selected = _selected.Contains(item.Id);
            <ListItem @key="item.Id" Selected="selected" OnClick="() => Toggle(item)" Class="chat-pick__item">
                <Leading><ChatAvatar Chat="item" Size="42" /></Leading>
                <ChildContent>
                    <div class="sm-list-item__title">@TitleOf(item)</div>
                    @if (item.IsArchived)
                    {
                        <div class="sm-list-item__subtitle">@L["chatlist.archive.title"]</div>
                    }
                    else if (item.Type == ChatType.Group)
                    {
                        <div class="sm-list-item__subtitle">@L.Plural("plural.members", item.MemberCount)</div>
                    }
                </ChildContent>
                <Trailing>
                    <span class="chat-pick__check @(selected ? "chat-pick__check--on" : null)" aria-hidden="true">
                        @if (selected)
                        {
                            <Icon Name="@IconNames.Check" Size="14" StrokeWidth="3" />
                        }
                    </span>
                </Trailing>
            </ListItem>
        }
    </div>
    <DialogActions>
        <Button Variant="ButtonVariant.Ghost" OnClick="Dialog.Cancel">@L["common.cancel"]</Button>
        <Button Icon="@IconNames.Check" OnClick="Done">@L["common.done"]</Button>
    </DialogActions>
</div>

@code {
    private string _query = "";
    private readonly List<Guid> _selected = [];
    private ChatSummaryDto? _saved;

    [CascadingParameter] public DialogReference Dialog { get; set; } = default!;
    /// <summary>Chats chosen so far (they come checked).</summary>
    [Parameter] public IReadOnlyList<Guid> Selected { get; set; } = [];
    /// <summary>Chats not offered (the folder's other list holds them).</summary>
    [Parameter] public IReadOnlyList<Guid> Exclude { get; set; } = [];

    private IReadOnlyList<ChatSummaryDto> Filtered
    {
        get
        {
            var all = new List<ChatSummaryDto>();
            if (_saved is not null) all.Add(_saved);
            foreach (var chat in ChatList.Chats.Concat(ChatList.ArchivedChats))
                if (all.All(c => c.Id != chat.Id)) all.Add(chat);
            var offered = all.Where(c => !Exclude.Contains(c.Id)).OrderByDescending(c => c.Type == ChatType.Saved).ToList();
            var q = _query.Trim();
            return q.Length == 0
                ? offered
                : offered.Where(c => TitleOf(c).Contains(q, StringComparison.CurrentCultureIgnoreCase)).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        RenderOn(h => ChatList.Changed += h, h => ChatList.Changed -= h);
        _selected.AddRange(Selected.Distinct());
        _saved = ChatList.Chats.Concat(ChatList.ArchivedChats).FirstOrDefault(c => c.Type == ChatType.Saved);
        if (_saved is null)
        {
            try
            {
                _saved = await ChatList.GetSavedMessagesAsync();
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "Saved Messages not available for the folder picker");
            }
        }
    }

    private string TitleOf(ChatSummaryDto chat) => chat.Type == ChatType.Saved ? L["common.savedMessages"] : ChatList.TitleOf(chat);

    private void Toggle(ChatSummaryDto chat)
    {
        if (!_selected.Remove(chat.Id)) _selected.Add(chat.Id);
    }

    private void Done() => Dialog.Close(_selected.ToList());
}
