{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=skymessage;Username=skymessage;Password=skymessage"
  },
  "Server": {
    "Name": "SkyMessage",
    "PublicBaseUrl": null,
    "RegistrationMode": "Open",
    "RegistrationCode": null,
    "MirrorUrls": [],
    "TrustedProxyNetworks": [],
    "MigrateOnStartup": true,
    "CorsOrigins": []
  },
  "Jwt": {
    "Issuer": "skymessage",
    "Audience": "skymessage-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 180
  },
  "Storage": {
    "MasterKey": "",
    "ChunkSize": 1048576,
    "MaxUploadBytes": 2147483648,
    "IncompleteUploadTtlHours": 24
  },
  "MediaProcessing": {
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "MaxConcurrency": 2
  },
  "LiveKit": {
    "Enabled": true,
    "ApiKey": "",
    "ApiSecret": "",
    "InternalUrl": "http://localhost:7880",
    "PublicUrl": "/livekit",
    "TokenTtlMinutes": 15
  },
  "Push": {
    "Enabled": false
  }
}
