# Copy to .env (never commit .env). Values below are for local development only.

# LAN IP of this machine (macOS: `ipconfig getifaddr en0`). Phones/emulators reach call media here.
LIVEKIT_NODE_IP=192.168.1.34

POSTGRES_PASSWORD=skymessage
# >= 32 random bytes in production: `openssl rand -base64 48`
JWT_SIGNING_KEY=dev-only-signing-key-change-me-0123456789abcdef
# Exactly 32 bytes, base64: `openssl rand -base64 32`. Losing it makes stored media unreadable.
STORAGE_MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS0zMi1ieXRlcyEhISE=
LIVEKIT_API_KEY=devkey
# Must match docker/livekit/livekit.yaml (keys / webhook)
LIVEKIT_API_SECRET=devsecret-change-me-0123456789abcdef0123456789
